---
import Layout from '../../../layouts/Layout.astro';
import ProjectCard from '../../../components/ProjectCard/ProjectCard.astro';
import Footer from '../../../components/Footer/Footer.astro';
import ServicePill from '../../../components/ServicePill/ServicePill.astro';
import { projects as baseProjects } from '../../../data/projects';
import { getLocalizedProjects, localizeServiceType } from '../../../data/projects-i18n';
import type { ServiceName } from '../../../data/projects/types';
import styles from '../../proyectos/projects.module.css';
import { projectsPageContent } from '../../../i18n/projects-content';

const projects = getLocalizedProjects('en');
const availableServices = new Set(baseProjects.flatMap((project) => project.services.map((service) => service.type)));
const serviceOrder: ServiceName[] = [
	'Branding',
	'Web',
	'Fotografía',
	'Decoración',
	'Redes Sociales',
	'Papelería',
	'Cinematografía'
];
const serviceFilters = serviceOrder.filter((service) => availableServices.has(service) || service === 'Decoración');

const normalizeService = (value: string) =>
	value
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.trim();

const content = projectsPageContent.en;
---

<Layout title="Projects | Gea Studio" description="Selected branding, digital, editorial, and visual direction projects by Gea Studio.">
	<main class={styles.page}>
		<header class={styles.header}>
			<h1 class={styles.title}>{content.title}</h1>
			<p class={styles.intro}>{content.intro}</p>
		</header>

		<div class={styles.filtersSticky}>
			<div class={styles.filtersBar} role="group" aria-label={content.filterAria} data-filter-bar>
				<ServicePill label={content.allFilter} pressed buttonRole="project-filter" dataService="all" />
				{
					serviceFilters.map((service) => (
						<ServicePill
							label={localizeServiceType(service, 'en')}
							buttonRole="project-filter"
							dataService={normalizeService(service)}
						/>
					))
				}
			</div>
		</div>

		<ul class={styles.grid} role="list" aria-label={content.listAria}>
			{
				projects.map((project, index) => (
					<li
						class={styles.item}
						data-project-item
						data-services={JSON.stringify(
							baseProjects[index].services.map((service) => normalizeService(service.type))
						)}
					>
						<ProjectCard {...project} number={project.id} compactMobile variant="grid" locale="en" />
					</li>
				))
			}
		</ul>
	</main>
	<Footer locale="en" />
	<script>
		const filterButtons = Array.from(
			document.querySelectorAll('[data-filter-bar] [data-service]')
		) as HTMLButtonElement[];
		const projectItems = Array.from(
			document.querySelectorAll('[data-project-item]')
		) as HTMLElement[];
		let activeService = 'all';
		const projectServices = new Map<HTMLElement, string[]>(
			projectItems.map((item) => {
				const servicesRaw = item.getAttribute('data-services') || '[]';
				const services = JSON.parse(servicesRaw) as string[];
				return [item, services];
			})
		);

		const updateFilters = () => {
			for (const item of projectItems) {
				const services = projectServices.get(item) || [];
				const isVisible = activeService === 'all' || services.includes(activeService);
				item.hidden = !isVisible;
			}
		};

		for (const button of filterButtons) {
			button.addEventListener('click', () => {
				const service = button.getAttribute('data-service');
				if (!service) return;
				if (service === activeService) return;

				activeService = service;

				for (const filterButton of filterButtons) {
					filterButton.setAttribute('aria-pressed', filterButton === button ? 'true' : 'false');
				}

				updateFilters();
			});
		}

		updateFilters();
	</script>
</Layout>
