---
import Layout from '../../../layouts/Layout.astro';
import ProjectTabs from '../../../components/ProjectTabs/ProjectTabs.astro';
import EditorialGallery from '../../../components/EditorialGallery/EditorialGallery.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import { getLocalizedProjectDescription, localizeServiceType } from '../../../data/projects-i18n';
import { projects as baseProjects } from '../../../data/projects';
import styles from '../../proyectos/project-detail.module.css';
import { projectDetailContent } from '../../../i18n/projects-content';

export function getStaticPaths() {
	return baseProjects.map((project) => ({
		params: { slug: project.slug },
		props: { slug: project.slug }
	}));
}

const projects = baseProjects;

const { slug } = Astro.props as { slug: string };

const projectIndex = projects.findIndex((item) => item.slug === slug);

if (projectIndex === -1) {
	throw new Error(`Project not found: ${slug}`);
}

const project = projects[projectIndex];
const previousProject = projects[(projectIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(projectIndex + 1) % projects.length];
const content = projectDetailContent.en;
const projectDescription = getLocalizedProjectDescription(project, 'en');

const toSectionId = (name: string) =>
	name
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.trim()
		.replace(/\s+/g, '-');

const encodeSegments = (...segments: string[]) => segments.map((segment) => encodeURIComponent(segment)).join('/');

const toProjectImageUrl = (...segments: string[]) => `/images/projects/${encodeSegments(...segments)}`;

const isPhotographySection = (name: string) => {
	const normalized = name
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase();

	return normalized === 'fotografia' || normalized === 'filmmaking' || normalized === 'photography';
};

const sections = project.services.map((service) => ({
	id: toSectionId(service.type),
	title: localizeServiceType(service.type, 'en'),
	isPhotography: service.gallery === 'fotografia' || isPhotographySection(service.type),
	isSocialMedia: service.gallery === 'redes-sociales',
	isWeb: service.gallery === 'web',
	websiteUrl: service.gallery === 'web' ? service.url : undefined,
	background: service.gallery === 'web' && service.background
		? toProjectImageUrl(project.assetsFolder, service.gallery, service.background)
		: undefined,
	video: service.gallery === 'web' && service.video
		? toProjectImageUrl(project.assetsFolder, service.gallery, service.video)
		: undefined,
	images: (service.images ?? []).map((filename) => toProjectImageUrl(project.assetsFolder, service.gallery, filename)),
	videos: (service.videos ?? []).map((filename) => toProjectImageUrl(project.assetsFolder, service.gallery, filename))
}));
---

<Layout title={`${project.title} | Gea Studio`} description={projectDescription}>
	<main class={styles.page}>
		<header class={styles.projectHeader}>
			<img class={styles.projectLogo} src={project.logo} alt={project.title} loading="eager" decoding="async" />
			<p class={styles.projectDescription}>{projectDescription}</p>
			<div class={styles.headerDivider} aria-hidden="true"></div>
		</header>

		<div class={styles.projectContent}>
		{
			sections.length > 0 && (
				<nav class={styles.sectionTabsWrap} aria-label={content.sectionsAria}>
					<div class={styles.sectionTabs}>
						<ProjectTabs
							sections={sections.map((section) => ({ id: section.id, label: section.title }))}
							ariaLabel={content.tabsAria}
						/>
					</div>
				</nav>
			)
		}

		{
			sections.map((section, index) => (
				<section
					id={`panel-${section.id}`}
					class={`${styles.section} ${section.isSocialMedia ? styles.socialMediaSection : ''}`}
					role="tabpanel"
					aria-labelledby={`tab-${section.id}`}
					data-project-panel
					data-panel-id={section.id}
					hidden={index !== 0}
				>
					<h2 id={`section-${section.id}`} class={styles.sectionTitle}>{section.title}</h2>
					{
						section.isWeb && (section.background || section.video) ? (
							<div
								class={`${styles.webComposition} ${!section.background ? styles.webCompositionPlain : ''} ${project.slug === 'g' ? styles.webCompositionG : ''}`}
								style={section.background ? `--web-background-image: url("${section.background}")` : '--web-background-image: none'}
							>
								{section.video ? (
									<video
										class={styles.webVideo}
										data-video-src={section.video}
										autoplay
										loop
										muted
										playsinline
										preload="none"
										aria-label={`${project.title} web design`}
									/>
								) : (
									<ResponsiveImage
										src={section.images[0]}
										alt={`${project.title} web design`}
										loading="lazy"
										decoding="async"
										sizes="(max-width: 767px) 92vw, 78vw"
										widths={[480, 768, 960, 1280, 1600]}
									/>
								)}
								{section.websiteUrl && (
									<a class={styles.webVisitButton} href={section.websiteUrl} target="_blank" rel="noreferrer">
										<span class={styles.webVisitLabel}><span>{content.visitWeb}</span></span>
										<span class={styles.webVisitDomain}>{section.websiteUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
										<span class={styles.webVisitArrow} aria-hidden="true">&#8594;</span>
									</a>
								)}
							</div>
						) : (
							<div class={styles.fullBleedGallery}>
						<EditorialGallery
							images={section.images}
							projectTitle={project.title}
							layout={section.isPhotography || section.isSocialMedia ? 'vertical' : 'editorial'}
									paddedImage={project.slug === 'gea-artesania' && section.isSocialMedia ? 'ig_1.png' : undefined}
									videos={section.videos}
									locale="en"
											frameFirstImages={project.slug === 'g' && section.id === 'branding'}
											insertBrandStatement={project.slug === 'g' && section.id === 'branding'}
											containLastImage={project.slug === 'talleres-alonso' && section.id === 'branding'}
											singleColumn={section.isSocialMedia}
											stackMobile={project.slug === 'gea-artesania' && section.id === 'branding'}
						/>
							</div>
						)
					}
				</section>
			))
		}

		<nav class={`${styles.projectNav} ${project.slug === 'talleres-alonso' ? styles.projectNavTalleres : ''}`} aria-label={content.navAria}>
			<a class={styles.projectLink} href={`/en/projects/${previousProject.slug}`}>
				<span class={styles.projectNavLabel}>{content.previous}</span>
				<span class={styles.projectNavTitle}>{previousProject.title}</span>
			</a>
			<a class={styles.projectLink} href={`/en/projects/${nextProject.slug}`}>
				<span class={styles.projectNavLabel}>{content.next}</span>
				<span class={styles.projectNavTitle}>{nextProject.title}</span>
			</a>
		</nav>
		</div>
	</main>
	<script>
		const tabs = Array.from(document.querySelectorAll('[data-project-tab]')) as HTMLButtonElement[];
		const panels = Array.from(document.querySelectorAll('[data-project-panel]')) as HTMLElement[];
		const tabsWrap = document.querySelector('[aria-label="Project sections"]') as HTMLElement | null;

		const setActiveTab = (targetId: string) => {
			for (const tab of tabs) {
				const isActive = tab.getAttribute('data-target') === targetId;
				tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
				tab.tabIndex = isActive ? 0 : -1;
			}

			for (const panel of panels) {
				const isActive = panel.getAttribute('data-panel-id') === targetId;
				panel.hidden = !isActive;
			}
		};

		const switchTabInPlace = (targetId: string) => {
			setActiveTab(targetId);
			requestAnimationFrame(() => {
				const targetTitle = document.getElementById(`section-${targetId}`);
				if (!targetTitle) return;

				const stickyOffset = tabsWrap?.getBoundingClientRect().height ?? 0;
				const targetTop = window.scrollY + targetTitle.getBoundingClientRect().top - stickyOffset;

				window.scrollTo({
					top: Math.max(0, targetTop),
					behavior: 'smooth'
				});
			});
		};

		for (const tab of tabs) {
			tab.addEventListener('click', (event) => {
				event.preventDefault();
				const targetId = tab.getAttribute('data-target');
				if (!targetId) return;
				switchTabInPlace(targetId);
			});

			tab.addEventListener('keydown', (event) => {
				const currentIndex = tabs.indexOf(tab);
				if (currentIndex === -1) return;

				let nextIndex = currentIndex;
				if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
				if (event.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
				if (event.key === 'Home') nextIndex = 0;
				if (event.key === 'End') nextIndex = tabs.length - 1;

				if (nextIndex === currentIndex) return;
				event.preventDefault();
				const nextTab = tabs[nextIndex];
				const targetId = nextTab?.getAttribute('data-target');
				if (!targetId) return;

				switchTabInPlace(targetId);
				nextTab.focus();
			});
		}

		const initialActiveTab = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') ?? tabs[0];
		const initialTargetId = initialActiveTab?.getAttribute('data-target');
		if (initialTargetId) {
			setActiveTab(initialTargetId);
		}
	</script>
</Layout>
