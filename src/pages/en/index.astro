---
import Hero from '../../components/Hero.astro';
import VisualChapter from '../../components/VisualChapter.astro';
import AboutSection from '../../components/AboutSection.astro';
import Projects from '../../components/Projects.astro';
import Services from '../../components/Services.astro';
import Footer from '../../components/Footer/Footer.astro';
import Layout from '../../layouts/Layout.astro';

const title =
	'Gea Studio | Creative studio for branding, web design, photography, editorial, interior design and social media.';
const description =
	'Gea Studio is a creative studio focused on branding, web design, photography, editorial systems, interior design, and social media direction for brands.';
---

<Layout title={title} description={description}>
	<Hero locale="en" />
	<div class="visualServicesStage">
		<VisualChapter />
		<div class="servicesLayer">
			<Services locale="en" />
		</div>
	</div>
	<Projects locale="en" />
	<AboutSection locale="en" />
	<Footer locale="en" />
</Layout>

<style>
	.visualServicesStage {
		position: relative;
		z-index: 0;
	}

	.servicesLayer {
		position: relative;
		z-index: 3;
		margin-top: -158svh;
	}

	@media (max-width: 900px) {
		.servicesLayer {
			margin-top: -82svh;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.servicesLayer {
			margin-top: 0;
		}
	}
</style>
