---
import ServiceDetailPage from '../../../components/ServiceDetailPage.astro';
import { servicesEn } from '../../../data/services-en';
import { servicePageContent } from '../../../i18n/services-content';

export function getStaticPaths() {
	return servicesEn.map((service) => ({
		params: { slug: service.slug }
	}));
}

const { slug } = Astro.params;
const service = servicesEn.find((item) => item.slug === slug);

if (!service) {
	throw new Response('Service not found', { status: 404 });
}
---

<ServiceDetailPage
	service={service}
	services={servicesEn}
	content={servicePageContent.en}
	servicesPath="/en/services"
	projectsPath="/en/projects"
	contactPath="/en/#contact"
/>
