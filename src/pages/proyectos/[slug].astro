---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer/Footer.astro';
import ProjectTabs from '../../components/ProjectTabs/ProjectTabs.astro';
import EditorialGallery from '../../components/EditorialGallery/EditorialGallery.astro';
import { projects } from '../../data/projects';
import styles from './project-detail.module.css';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { slug: project.slug }
	}));
}

const { slug } = Astro.props as { slug: string };

const projectIndex = projects.findIndex((item) => item.slug === slug);

if (projectIndex === -1) {
	throw new Error(`Project not found: ${slug}`);
}

const project = projects[projectIndex];
const previousProject = projects[(projectIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(projectIndex + 1) % projects.length];
const clientLabel = project.client.replace(/^by\s+/i, '').toUpperCase();

const toSectionId = (name: string) =>
	name
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.trim()
		.replace(/\s+/g, '-');

const sections = project.services.map((service) => ({
	id: toSectionId(service.type),
	title: service.type,
	images: service.images
}));
---

<Layout>
	<main class={styles.page}>
		<header class={styles.projectHeader}>
			<img class={styles.projectLogo} src={project.logo} alt={project.title} loading="eager" decoding="async" />
			<p class={styles.projectDescription}>{project.description}</p>
			<p class={styles.projectMetaLine}>BY {clientLabel}</p>
		</header>

		<figure class={styles.cover}>
			<img src={project.heroImage} alt={project.title} loading="eager" fetchpriority="high" decoding="async" />
		</figure>

		<div class={styles.divider} aria-hidden="true"></div>

		{
			sections.length > 0 && (
				<nav class={styles.sectionTabsWrap} aria-label="Secciones del proyecto">
					<div class={styles.sectionTabs}>
						<ProjectTabs sections={sections.map((section) => ({ id: section.id, label: section.title }))} />
					</div>
				</nav>
			)
		}

		{
			sections.map((section, index) => (
				<section
					id={`panel-${section.id}`}
					class={styles.section}
					role="tabpanel"
					aria-labelledby={`tab-${section.id}`}
					data-project-panel
					data-panel-id={section.id}
					hidden={index !== 0}
				>
					<h2 id={`section-${section.id}`} class={styles.sectionTitle}>{section.title}</h2>
					<div class={styles.fullBleedGallery}>
						<EditorialGallery images={section.images} projectTitle={project.title} />
					</div>
				</section>
			))
		}

		<nav class={styles.projectNav} aria-label="Navegación de proyectos">
			<a class={styles.projectLink} href={`/proyectos/${previousProject.slug}`}>
				<span class={styles.projectNavLabel}>← Proyecto anterior</span>
				<span class={styles.projectNavTitle}>{previousProject.title}</span>
			</a>
			<a class={styles.projectLink} href={`/proyectos/${nextProject.slug}`}>
				<span class={styles.projectNavLabel}>Proyecto siguiente →</span>
				<span class={styles.projectNavTitle}>{nextProject.title}</span>
			</a>
		</nav>
	</main>
	<Footer />
	<script>
		const tabs = Array.from(document.querySelectorAll('[data-project-tab]')) as HTMLButtonElement[];
		const panels = Array.from(document.querySelectorAll('[data-project-panel]')) as HTMLElement[];

		const setActiveTab = (targetId: string) => {
			for (const tab of tabs) {
				const isActive = tab.getAttribute('data-target') === targetId;
				tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
				tab.tabIndex = isActive ? 0 : -1;
			}

			for (const panel of panels) {
				const isActive = panel.getAttribute('data-panel-id') === targetId;
				panel.hidden = !isActive;
			}
		};

		const switchTabInPlace = (targetId: string) => {
			const previousY = window.scrollY;
			setActiveTab(targetId);
			requestAnimationFrame(() => {
				window.scrollTo(0, previousY);
			});
		};

		for (const tab of tabs) {
			tab.addEventListener('click', (event) => {
				event.preventDefault();
				const targetId = tab.getAttribute('data-target');
				if (!targetId) return;
				switchTabInPlace(targetId);
			});

			tab.addEventListener('keydown', (event) => {
				const currentIndex = tabs.indexOf(tab);
				if (currentIndex === -1) return;

				let nextIndex = currentIndex;
				if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
				if (event.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
				if (event.key === 'Home') nextIndex = 0;
				if (event.key === 'End') nextIndex = tabs.length - 1;

				if (nextIndex === currentIndex) return;
				event.preventDefault();
				const nextTab = tabs[nextIndex];
				const targetId = nextTab?.getAttribute('data-target');
				if (!targetId) return;

				switchTabInPlace(targetId);
				nextTab.focus();
			});
		}

		const initialActiveTab = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') ?? tabs[0];
		const initialTargetId = initialActiveTab?.getAttribute('data-target');
		if (initialTargetId) {
			setActiveTab(initialTargetId);
		}
	</script>
</Layout>
