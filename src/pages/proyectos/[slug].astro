---
import Layout from '../../layouts/Layout.astro';
import ProjectTabs from '../../components/ProjectTabs/ProjectTabs.astro';
import EditorialGallery from '../../components/EditorialGallery/EditorialGallery.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { projects } from '../../data/projects';
import styles from './project-detail.module.css';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { slug: project.slug }
	}));
}

const { slug } = Astro.props as { slug: string };

const projectIndex = projects.findIndex((item) => item.slug === slug);

if (projectIndex === -1) {
	throw new Error(`Project not found: ${slug}`);
}

const project = projects[projectIndex];
const previousProject = projects[(projectIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(projectIndex + 1) % projects.length];
const clientLabel = project.client.replace(/^by\s+/i, '').toUpperCase();

const toSectionId = (name: string) =>
	name
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.trim()
		.replace(/\s+/g, '-');

const encodeSegments = (...segments: string[]) => segments.map((segment) => encodeURIComponent(segment)).join('/');

const toProjectImageUrl = (...segments: string[]) => `/images/projects/${encodeSegments(...segments)}`;

const isPhotographySection = (name: string) => {
	const normalized = name
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase();

	return normalized === 'fotografia' || normalized === 'filmmaking';
};

const sections = project.services.map((service) => ({
	id: toSectionId(service.type),
	title: service.type,
	isPhotography: isPhotographySection(service.type),
	isWeb: service.type === 'Web' && service.gallery === 'web',
		websiteUrl: service.type === 'Web' && service.gallery === 'web' ? service.url : undefined,
	background: service.type === 'Web' && service.gallery === 'web' && service.background
		? toProjectImageUrl(project.assetsFolder, service.gallery, service.background)
		: undefined,
	video: service.type === 'Web' && service.gallery === 'web' && service.video
		? toProjectImageUrl(project.assetsFolder, service.gallery, service.video)
		: undefined,
	images: (service.images ?? []).map((filename) => toProjectImageUrl(project.assetsFolder, service.gallery, filename))
}));
---

<Layout>
	<main class={styles.page}>
		<header class={styles.projectHeader}>
			<img class={styles.projectLogo} src={project.logo} alt={project.title} loading="eager" decoding="async" />
			<p class={styles.projectDescription}>{project.description}</p>
		</header>

		<figure class={styles.cover}>
			<ResponsiveImage
				src={project.heroImage}
				alt={project.title}
				loading="eager"
				fetchpriority="high"
				decoding="async"
				sizes="(max-width: 1200px) 100vw, 1120px"
				widths={[768, 1120, 1440, 1920]}
			/>
		</figure>

		<div class={styles.divider} aria-hidden="true"></div>

		{
			sections.length > 0 && (
				<nav class={styles.sectionTabsWrap} aria-label="Secciones del proyecto">
					<div class={styles.sectionTabs}>
						<ProjectTabs
							sections={sections.map((section) => ({ id: section.id, label: section.title }))}
							ariaLabel="Navegación de secciones del proyecto"
						/>
					</div>
				</nav>
			)
		}

		{
			sections.map((section, index) => (
				<section
					id={`panel-${section.id}`}
					class={styles.section}
					role="tabpanel"
					aria-labelledby={`tab-${section.id}`}
					data-project-panel
					data-panel-id={section.id}
					hidden={index !== 0}
				>
					<h2 id={`section-${section.id}`} class={styles.sectionTitle}>{section.title}</h2>
					{
						section.isWeb && section.background ? (
							<div
								class={styles.webComposition}
								style={`--web-background-image: url("${section.background}")`}
							>
								{section.video ? (
									<video
										class={styles.webVideo}
										src={section.video}
										controls
										playsinline
										preload="metadata"
										aria-label={`${project.title} web design`}
									/>
								) : (
									<ResponsiveImage
										src={section.images[0]}
										alt={`${project.title} web design`}
										loading="lazy"
										decoding="async"
										sizes="(max-width: 767px) 92vw, 78vw"
										widths={[480, 768, 960, 1280, 1600]}
									/>
								)}
								{section.websiteUrl && (
									<a
										class={styles.webVisitButton}
										href={section.websiteUrl}
										target="_blank"
										rel="noreferrer"
									>
										<span class={styles.webVisitLabel}>
											<span>VISITAR WEB</span>
										</span>
										<span class={styles.webVisitDomain}>
											{section.websiteUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}
										</span>
										<span class={styles.webVisitArrow} aria-hidden="true">&#8594;</span>
									</a>
								)}
							</div>
						) : (
							<div class={styles.fullBleedGallery}>
								<EditorialGallery
									images={section.images}
									projectTitle={project.title}
									layout={section.isPhotography ? 'vertical' : 'editorial'}
								/>
							</div>
						)
					}
				</section>
			))
		}

		<nav class={styles.projectNav} aria-label="Navegación de proyectos">
			<a class={styles.projectLink} href={`/proyectos/${previousProject.slug}`}>
				<span class={styles.projectNavLabel}>← Proyecto anterior</span>
				<span class={styles.projectNavTitle}>{previousProject.title}</span>
			</a>
			<a class={styles.projectLink} href={`/proyectos/${nextProject.slug}`}>
				<span class={styles.projectNavLabel}>Proyecto siguiente →</span>
				<span class={styles.projectNavTitle}>{nextProject.title}</span>
			</a>
		</nav>
	</main>
	<script>
		const tabs = Array.from(document.querySelectorAll('[data-project-tab]')) as HTMLButtonElement[];
		const panels = Array.from(document.querySelectorAll('[data-project-panel]')) as HTMLElement[];
		const projectMain = document.querySelector('main') as HTMLElement | null;
		const tabsWrap = document.querySelector('[aria-label="Secciones del proyecto"]') as HTMLElement | null;
		const setActiveTab = (targetId: string) => {
			for (const tab of tabs) {
				const isActive = tab.getAttribute('data-target') === targetId;
				tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
				tab.tabIndex = isActive ? 0 : -1;
			}

			for (const panel of panels) {
				const isActive = panel.getAttribute('data-panel-id') === targetId;
				panel.hidden = !isActive;
			}
		};

		const switchTabInPlace = (targetId: string) => {
			const previousScrollY = window.scrollY;
			const mainTop = projectMain
				? projectMain.getBoundingClientRect().top + previousScrollY
				: 0;
			setActiveTab(targetId);

			if (!projectMain) return;

			const requiredMainHeight = previousScrollY + window.innerHeight - mainTop;

			if (projectMain.offsetHeight < requiredMainHeight) {
				projectMain.style.minHeight = `${requiredMainHeight}px`;
			}

			window.scrollTo({ top: previousScrollY, behavior: 'auto' });

			requestAnimationFrame(() => {
				const tabsRect = tabsWrap?.getBoundingClientRect();
				const targetTitle = document.getElementById(`section-${targetId}`);
				if (!tabsRect || !targetTitle || tabsRect.top > 80) return;

				const titleRect = targetTitle.getBoundingClientRect();
				const targetTop = window.scrollY + titleRect.top - tabsRect.bottom - 16;

				window.scrollTo({
					top: Math.max(0, targetTop),
					behavior: 'smooth'
				});
			});
		};

		for (const tab of tabs) {
			tab.addEventListener('click', (event) => {
				event.preventDefault();
				const targetId = tab.getAttribute('data-target');
				if (!targetId) return;
				switchTabInPlace(targetId);
			});

			tab.addEventListener('keydown', (event) => {
				const currentIndex = tabs.indexOf(tab);
				if (currentIndex === -1) return;

				let nextIndex = currentIndex;
				if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
				if (event.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
				if (event.key === 'Home') nextIndex = 0;
				if (event.key === 'End') nextIndex = tabs.length - 1;

				if (nextIndex === currentIndex) return;
				event.preventDefault();
				const nextTab = tabs[nextIndex];
				const targetId = nextTab?.getAttribute('data-target');
				if (!targetId) return;

				switchTabInPlace(targetId);
				nextTab.focus();
			});
		}

		const initialActiveTab = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') ?? tabs[0];
		const initialTargetId = initialActiveTab?.getAttribute('data-target');
		if (initialTargetId) {
			setActiveTab(initialTargetId);
		}
	</script>
</Layout>
