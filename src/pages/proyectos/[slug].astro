---
import Layout from '../../layouts/Layout.astro';

interface ProjectRoute {
	slug: string;
	title: string;
}

const projectRoutes: ProjectRoute[] = [
	{ slug: 'talleres-alonso', title: 'Talleres Alonso' },
	{ slug: 'g', title: '.G' },
	{ slug: 'gea-artesania', title: 'Gea Artesania' },
	{ slug: 'foc', title: 'Foc' },
	{ slug: 'margen', title: 'Margen' },
	{ slug: 'trop', title: 'Trop' }
];

export function getStaticPaths() {
	return projectRoutes.map((project) => ({
		params: { slug: project.slug },
		props: { title: project.title }
	}));
}

const { title } = Astro.props as { title: string };
---

<Layout>
	<main style="min-height: 60vh; display: grid; place-items: center; padding: 48px 24px; text-align: center;">
		<h1 style="margin: 0; font-family: 'Krona One', sans-serif; font-size: clamp(28px, 4vw, 44px); font-weight: 400; color: #1e1e1e;">
			{title}
		</h1>
	</main>
</Layout>
