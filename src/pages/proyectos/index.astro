---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard/ProjectCard.astro';
import Footer from '../../components/Footer/Footer.astro';
import ServicePill from '../../components/ServicePill/ServicePill.astro';
import { projects } from '../../data/projects';
import type { ServiceName } from '../../data/projects/types';
import styles from './projects.module.css';

const availableServices = new Set(projects.flatMap((project) => project.services.map((service) => service.type)));
const serviceOrder: ServiceName[] = [
	'Branding',
	'Web',
	'Fotografía',
	'Decoración',
	'Redes Sociales',
	'Papelería',
	'Cinematografía'
];
const serviceFilters = serviceOrder.filter(
	(service) => availableServices.has(service) || service === 'Decoración'
);

const normalizeService = (value: string) =>
	value
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.trim();

---

<Layout>
	<main class={styles.page}>
		<header class={styles.header}>
			<h1 class={styles.title}>PROYECTOS</h1>
			<p class={styles.intro}>
				Desde 2026 creando universos creativos con gente como tú. Aquí listamos todos nuestros
				proyectos hechos con mucho amor y cariño.
			</p>
		</header>

		<div class={styles.filtersSticky}>
			<div class={styles.filtersBar} role="group" aria-label="Filtrar proyectos por servicio" data-filter-bar>
				<ServicePill label="Todos" pressed buttonRole="project-filter" dataService="all" />
				{
					serviceFilters.map((service) => (
						<ServicePill
							label={service}
							buttonRole="project-filter"
							dataService={normalizeService(service)}
						/>
					))
				}
			</div>
		</div>

		<ul class={styles.grid} role="list" aria-label="Listado de proyectos">
			{
				projects.map((project) => (
					<li
						class={styles.item}
						data-project-item
						data-services={JSON.stringify(
							project.services.map((service) => normalizeService(service.type))
						)}
					>
						<ProjectCard {...project} number={project.id} compactMobile variant="grid" />
					</li>
				))
			}
		</ul>
	</main>
	<Footer />
	<script>
		const filterButtons = Array.from(
			document.querySelectorAll('[data-filter-bar] [data-service]')
		) as HTMLButtonElement[];
		const projectItems = Array.from(
			document.querySelectorAll('[data-project-item]')
		) as HTMLElement[];
		let activeService = 'all';
		const projectServices = new Map<HTMLElement, string[]>(
			projectItems.map((item) => {
				const servicesRaw = item.getAttribute('data-services') || '[]';
				const services = JSON.parse(servicesRaw) as string[];
				return [item, services];
			})
		);

		const updateFilters = () => {
			for (const item of projectItems) {
				const services = projectServices.get(item) || [];
				const isVisible = activeService === 'all' || services.includes(activeService);
				item.hidden = !isVisible;
			}
		};

		for (const button of filterButtons) {
			button.addEventListener('click', () => {
				const service = button.getAttribute('data-service');
				if (!service) return;
				if (service === activeService) return;

				activeService = service;

				for (const filterButton of filterButtons) {
					filterButton.setAttribute('aria-pressed', filterButton === button ? 'true' : 'false');
				}

				updateFilters();
			});
		}

		updateFilters();
	</script>
</Layout>
