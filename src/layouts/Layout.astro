---
import '../styles/global.css';
import SiteNav from '../components/SiteNav/SiteNav.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Gea | Estudio creativo de branding, diseño web, fotografía, papelería, decoración, cinematografía y redes sosicales.',
	description = 'Gea es un estudio creativo especializado en branding, diseño web, fotografía, decoración, cinematografía, papelería, redes sociales y dirección creativa para marcas y empresas.'
} = Astro.props as Props;

const pathname = Astro.url.pathname;
const overlayHero = pathname === '/' || pathname.startsWith('/services/');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta
  		name="description"
	 		content={description}
		/>
		<meta name="theme-color" content="#F8F8F8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<SiteNav overlayHero={overlayHero} />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #F8F8F8;
	}
</style>
