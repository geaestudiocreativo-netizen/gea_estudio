---
import styles from './ProjectCard.module.css';

type ServiceItem = string | { type: string };

interface Props {
	id: string;
	slug: string;
	number: string;
	title: string;
	description: string;
	services: ServiceItem[];
	image?: string;
	imageSize: 'small' | 'medium' | 'large';
	compactMobile?: boolean;
	variant?: 'carousel' | 'grid';
}

const {
	id,
	slug,
	number,
	title,
	description,
	services,
	image,
	imageSize,
	compactMobile = false,
	variant = 'carousel'
} = Astro.props as Props;

const sizeClassByKey = {
	small: styles.imageSmall,
	medium: styles.imageMedium,
	large: styles.imageLarge
};

const sizeClass = sizeClassByKey[imageSize] ?? styles.imageMedium;

const projectVariantClassByKey = {
	carousel: styles.projectCarousel,
	grid: styles.projectGrid
};

const cardLinkVariantClassByKey = {
	carousel: styles.cardLinkCarousel,
	grid: styles.cardLinkGrid
};

const projectVariantClass = projectVariantClassByKey[variant] ?? styles.projectCarousel;
const cardLinkVariantClass = cardLinkVariantClassByKey[variant] ?? styles.cardLinkCarousel;

const normalizedId = String(id).padStart(2, '0');
const fallbackImage = `project-${normalizedId}.jpg`;
const imageFileName = image ?? fallbackImage;
const imagePath = imageFileName.startsWith('/images/projects/')
	? imageFileName
	: `/images/projects/${imageFileName}`;

const projectHref = `/proyectos/${slug}`;
const serviceLabels = services.map((service) => (typeof service === 'string' ? service : service.type));
---

<a class={`${styles.cardLink} ${cardLinkVariantClass}`} href={projectHref} aria-label={`Ver proyecto ${title}`}>
	<article class={`${styles.project} ${projectVariantClass} ${compactMobile ? styles.compactMobile : ''}`}>
		<p class={styles.number}>{number}</p>

		<div class={`${styles.media} ${sizeClass}`}>
			<img src={imagePath} alt={title} class={styles.image} loading="lazy" decoding="async" />
		</div>

		<h3 class={styles.title}>{title}</h3>
		<p class={styles.description}>{description}</p>
		<p class={styles.services}>{serviceLabels.join(' · ')}</p>
	</article>
</a>
