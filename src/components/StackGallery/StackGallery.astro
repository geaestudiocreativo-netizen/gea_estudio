---
import styles from './StackGallery.module.css';
import ResponsiveImage from '../ResponsiveImage.astro';

interface Props {
	images: string[];
	projectTitle: string;
	serviceType: string;
}

const { images, projectTitle, serviceType } = Astro.props as Props;
---

<div class={styles.stackGallery}>
	{
		images.map((image, index) => (
			<figure class={styles.galleryItem}>
				<ResponsiveImage
					src={image}
					alt={`${projectTitle} ${serviceType} ${index + 1}`}
					loading="lazy"
					decoding="async"
					sizes="(max-width: 767px) 100vw, 50vw"
					widths={[480, 768, 960, 1280, 1600]}
				/>
			</figure>
		))
	}
</div>
