---
import styles from './Services.module.css';
import { services } from '../data/services';
---

<section id="services" class={styles.services} aria-labelledby="services-title">
	<div class={styles.content}>
		<h2 id="services-title" class={styles.heading}>
			<a href="/servicios" aria-label="Ver servicios" class={styles.headingLink}>QUÉ <span class={styles.headingBreak}>HACEMOS</span></a>
		</h2>
		<p class={styles.introHeadline}>Seis disciplinas. Un mismo universo visual.</p>
		<p class={styles.introSupporting}>Todo lo que una marca necesita para comunicar con coherencia.</p>

		<ul class={styles.list} role="list">
			{
				services.map((service) => (
					<li class={styles.serviceRow} data-size={service.homeSize}>
						<a class={styles.serviceCardLink} href={`/services/${service.slug}`} aria-label={`Ver servicio de ${service.homeTitle}`}>
							<div class={`${styles.media} ${styles[service.homeSize]}`}>
								<img src={service.homeImage} alt={service.homeAlt} loading="lazy" decoding="async" />
							</div>
							<div class={styles.serviceContent}>
								<div class={styles.serviceHeading}>
									<h3 class={styles.title}>{service.homeTitle}</h3>
								</div>
								<p class={styles.description}>{service.homeDescription}</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>