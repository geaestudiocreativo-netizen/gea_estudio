---
import styles from './Services.module.css';
import { services } from '../data/services';
import { servicesEn } from '../data/services-en';
import { servicesSectionContent } from '../i18n/home-content';
import { getLocalizedPath, type Locale } from '../i18n/site';

interface Props {
	locale?: Locale;
}

const { locale = 'es' } = Astro.props as Props;
const content = servicesSectionContent[locale];
const list = locale === 'en' ? servicesEn : services;
const serviceBasePath = getLocalizedPath(locale, '/services');
---

<section id="services" class={styles.services} aria-labelledby="services-title">
	<div class={styles.content}>
		<h2 id="services-title" class={styles.heading}>
			<a href={getLocalizedPath(locale, '/#services')} aria-label={content.headingAria} class={styles.headingLink}>{content.heading} <span class={styles.headingBreak}>{content.headingBreak}</span></a>
		</h2>
		<p class={styles.introHeadline}>
			{content.introHeadlineLines.map((line) => (
				<span class={styles.introHeadlineLine}>{line}</span>
			))}
		</p>
		<p class={styles.introSupporting}>{content.introSupporting}</p>

		<ul class={styles.list} role="list">
			{
				list.map((service) => (
					<li class={styles.serviceRow} data-size={service.homeSize}>
						<a class={styles.serviceCardLink} href={`${serviceBasePath}/${service.slug}`} aria-label={`${content.serviceAriaPrefix} ${service.homeTitle}`}>
							<div class={`${styles.media} ${styles[service.homeSize]}`}>
								<img src={service.homeImage} alt={service.homeAlt} loading="lazy" decoding="async" />
							</div>
							<div class={styles.serviceContent}>
								<div class={styles.serviceHeading}>
									<h3 class={styles.title}>{service.homeTitle}</h3>
								</div>
								<p class={styles.description}>{service.homeDescription}</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>