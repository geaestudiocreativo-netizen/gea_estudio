---
import styles from './Services.module.css';

const services = [
	{
		title: 'Branding',
		description: 'Identidades visuales y dirección de arte para marcas con personalidad.',
		alt: 'Editorial branding artwork on a ceramic vase',
		image: '/images/services/branding/branding-home.jpg',
		size: 'imageL'
	},
	{
		title: 'Fotografía & Cinematografía',
		description: 'Fotografía y vídeo editorial para marcas, productos y espacios.',
		alt: 'Portrait photographer holding a camera',
		image: '/images/services/fotografia/fotografia-home.jpg',
		size: 'imageM'
	},
	{
		title: 'Web',
		description: 'Webs diseñadas para transmitir confianza y convertir visitas en clientes.',
		alt: 'Website design shown on a tablet screen',
		image: '/images/services/web/web-home.jpg',
		size: 'imageXS'
	},
	{
		title: 'Editorial',
		description: 'Revistas, álbumes y piezas editoriales pensadas para contar historias.',
		alt: 'Premium stationery invitation and card set',
		image: '/images/services/papeleria/papeleria-home.jpg',
		size: 'imageM'
	},
	{
		title: 'Decoración',
		description: 'Diseño de interiores para espacios con identidad propia.',
		alt: 'Interior design living room with framed wall gallery',
		image: '/images/services/decoracion/decoracion-home.jpg',
		size: 'imageL'
	},
	{
		title: 'Redes Sociales',
		description: 'Dirección creativa y contenido visual para marcas en redes sociales.',
		alt: 'Social media profile displayed on a smartphone',
		image: '/images/services/redes-sociales/redes_sociales-home.jpg',
		size: 'imageS'
	}
];
---

<section class={styles.services} aria-labelledby="services-title">
	<div class={styles.content}>
		<h2 id="services-title" class={styles.heading}>
			<a href="/servicios" aria-label="Ver servicios" class={styles.headingLink}>QUÉ <span class={styles.headingBreak}>HACEMOS</span></a>
		</h2>

		<ul class={styles.list} role="list">
			{
				services.map((service) => (
					<li class={styles.serviceRow} data-size={service.size}>
						<div class={`${styles.media} ${styles[service.size]}`}>
							<img src={service.image} alt={service.alt} loading="lazy" decoding="async" />
						</div>
						<div class={styles.serviceContent}>
							<div class={styles.serviceHeading}>
								<h3 class={styles.title}>{service.title}</h3>
							</div>
							<p class={styles.description}>{service.description}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>