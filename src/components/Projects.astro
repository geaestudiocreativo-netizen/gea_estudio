---
import ProjectCard from './ProjectCard/ProjectCard.astro';
import PrimaryButton from './PrimaryButton/PrimaryButton.astro';
import styles from './Projects.module.css';
import { getLocalizedProjects } from '../data/projects-i18n';
import { projectsSectionContent } from '../i18n/home-content';
import { getLocalizedPath, type Locale } from '../i18n/site';

interface Props {
	locale?: Locale;
}

const { locale = 'es' } = Astro.props as Props;
const content = projectsSectionContent[locale];
const projects = getLocalizedProjects(locale);
const projectsHref = getLocalizedPath(locale, '/proyectos');
---

<section id="projects" class={styles.projects} aria-labelledby="projects-title">
	<div class={styles.layout}>
		<h2 id="projects-title" class={styles.title}>{content.title}</h2>

			<div class={styles.carousel} aria-label={content.carouselLabel} tabindex="0" data-project-carousel>
			<ul class={styles.track} role="list">
				{
					projects.map((project) => (
						<li class={styles.item}>
							<ProjectCard {...project} number={project.id} locale={locale} />
						</li>
					))
				}
			</ul>
		</div>

		<div class={styles.cta}>
			<button class={styles.carouselArrow} type="button" aria-label={locale === 'en' ? 'Previous projects' : 'Proyectos anteriores'} data-carousel-direction="previous">
				<span aria-hidden="true">←</span>
			</button>
			<PrimaryButton
				href={projectsHref}
				label={content.cta}
				desktopLabel={locale === 'en' ? 'VIEW ALL' : 'VER TODOS'}
				ariaLabel={content.ctaAria}
				variant="outline"
				className={styles.ctaButton}
			/>
			<button class={styles.carouselArrow} type="button" aria-label={locale === 'en' ? 'Next projects' : 'Siguientes proyectos'} data-carousel-direction="next">
				<span aria-hidden="true">→</span>
			</button>
		</div>
	</div>
</section>

<script>
	const projectCarousel = document.querySelector('[data-project-carousel]');
	const carouselDirections = document.querySelectorAll<HTMLButtonElement>('[data-carousel-direction]');

	carouselDirections.forEach((button) => {
		button.addEventListener('click', () => {
			const direction = button.dataset.carouselDirection === 'previous' ? -1 : 1;
			const firstCard = projectCarousel?.querySelector<HTMLElement>('li');
			const gap = firstCard ? parseFloat(getComputedStyle(firstCard.parentElement as HTMLElement).gap) || 0 : 0;
			const scrollDistance = (firstCard?.getBoundingClientRect().width ?? 0) + gap;
			projectCarousel?.scrollBy({ left: direction * scrollDistance, behavior: 'smooth' });
		});
	});
</script>
