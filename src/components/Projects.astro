---
import ProjectCard from './ProjectCard/ProjectCard.astro';
import PrimaryButton from './PrimaryButton/PrimaryButton.astro';
import styles from './Projects.module.css';
import { projects } from '../data/projects';
---

<section id="projects" class={styles.projects} aria-labelledby="projects-title">
	<div class={styles.layout}>
		<h2 id="projects-title" class={styles.title}>PROYECTOS</h2>

		<div class={styles.carousel} aria-label="Project portfolio carousel" tabindex="0">
			<ul class={styles.track} role="list">
				{
					projects.map((project) => (
						<li class={styles.item}>
							<ProjectCard {...project} number={project.id} />
						</li>
					))
				}
			</ul>
		</div>

		<PrimaryButton href="/proyectos" label="Ver proyectos" ariaLabel="Ver proyectos" className={styles.cta} />
	</div>
</section>
