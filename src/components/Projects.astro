---
import ProjectCard from './ProjectCard.astro';
import styles from './Projects.module.css';
import { projects } from '../data/projects';
---

<section class={styles.projects} aria-labelledby="projects-title">
	<div class={styles.layout}>
		<h2 id="projects-title" class={styles.title}>PROYECTOS</h2>

		<div class={styles.carousel} aria-label="Project portfolio carousel" tabindex="0">
			<ul class={styles.track} role="list">
				{
					projects.map((project) => (
						<li class={styles.item}>
							<ProjectCard {...project} number={project.id} />
						</li>
					))
				}
			</ul>
		</div>

		<a class={styles.cta} href="/proyectos" aria-label="Ver proyectos">
			Ver proyectos
		</a>
	</div>
</section>
