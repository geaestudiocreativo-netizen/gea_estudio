---
import styles from './BrandingGallery.module.css';
import ResponsiveImage from '../ResponsiveImage.astro';

interface Props {
	images: string[];
	projectTitle: string;
	serviceType: string;
	layout: 'branding-a' | 'branding-b' | 'branding-c';
}

const { images, projectTitle, serviceType, layout } = Astro.props as Props;

const layoutClass = styles[layout] ?? styles['branding-a'];
---

<div class={`${styles.brandingGrid} ${layoutClass}`}>
	{
		images.map((image, index) => (
			<figure class={styles.brandingItem}>
				<ResponsiveImage
					src={image}
					alt={`${projectTitle} ${serviceType} ${index + 1}`}
					loading="lazy"
					decoding="async"
					sizes="(max-width: 767px) 100vw, 50vw"
					widths={[480, 768, 960, 1280, 1600]}
				/>
			</figure>
		))
	}
</div>
