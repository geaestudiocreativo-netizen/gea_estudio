---
import styles from './PrimaryButton.module.css';

interface Props {
	href: string;
	label: string;
	ariaLabel?: string;
	className?: string;
	mobileFull?: boolean;
	variant?: 'default' | 'outline';
}

const { href, label, ariaLabel, className = '', mobileFull = true, variant = 'default' } = Astro.props as Props;
const mobileWidthClass = mobileFull ? styles.mobileFull : '';
const variantClass = variant === 'outline' ? styles.outline : '';
const composedClass = [styles.button, variantClass, mobileWidthClass, className].filter(Boolean).join(' ');
---

<a class={composedClass} href={href} aria-label={ariaLabel ?? label}>
	{label}
</a>
