---
import styles from "./SiteNav.module.css";
import { getLanguageSwitchPath, menuFooterCopy, navLabels } from "../../i18n/site";

interface Props {
	locale?: "es" | "en";
	pathname?: string;
}

const { locale = "es", pathname = "/" } = Astro.props as Props;
const homeHref = locale === "en" ? "/en" : "/";
const projectsHref = locale === "en" ? "/en/projects" : "/proyectos";
const servicesHref = `${homeHref}#services`;
const aboutHref = `${homeHref}#about`;
const contactHref = `${homeHref}#contact`;
const labels = navLabels[locale];
const footerCopy = menuFooterCopy[locale];
const desktopLinks = [
	{ href: servicesHref, label: labels.services },
	{ href: projectsHref, label: labels.projects },
	{ href: aboutHref, label: labels.studio },
	{ href: contactHref, label: labels.contact },
];
const mobileLinks = [
	{ href: servicesHref, label: labels.services },
	{ href: projectsHref, label: labels.projects },
	{ href: aboutHref, label: locale === "en" ? "About Gea" : "Sobre Gea" },
	{ href: contactHref, label: labels.contact },
];
const spanishSwitchPath = getLanguageSwitchPath(pathname, "es");
const englishSwitchPath = getLanguageSwitchPath(pathname, "en");
const switchPath = locale === "en" ? spanishSwitchPath : englishSwitchPath;
const switchLabel = locale === "en" ? footerCopy.es : footerCopy.en;
const navCopy = locale === "en"
	? { home: "Gea home", main: "Main navigation", language: "Language selector", open: "Open menu", close: "Close menu", mobile: "Mobile navigation", overlay: "Overlay footer" }
	: { home: "Inicio de Gea", main: "Navegación principal", language: "Selector de idioma", open: "Abrir menú", close: "Cerrar menú", mobile: "Navegación móvil", overlay: "Pie de menú" };
---

<header
	class={styles.nav}
	data-site-nav
	data-scrolled="false"
	data-menu-open="false"
>
	<div class={styles.inner}>
		<a class={styles.logo} href={homeHref} aria-label={navCopy.home}>
			<img
				class={styles.logoImage}
				src="/images/Logotype.svg"
				alt="Gea"
				loading="eager"
				decoding="async"
			/>
		</a>

		<nav class={styles.desktopNav} aria-label={navCopy.main}>
			{
				desktopLinks.map((link) => (
					<a class={styles.desktopLink} href={link.href}>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class={styles.navControls}>
			<div
				class={styles.languageSelector}
				role="group"
				aria-label={navCopy.language}
			>
				<a
					class={styles.languageOption}
					href={switchPath}
					data-language-link
				>
					{switchLabel}
				</a>
			</div>

			<button
				class={styles.menuButton}
				type="button"
				aria-label={navCopy.open}
				aria-expanded="false"
				data-nav-toggle
			>
				<span class={styles.menuIcon} aria-hidden="true">
					<span class={styles.menuLine}></span>
					<span class={styles.menuLine}></span>
					<span class={styles.menuLine}></span>
				</span>
			</button>
		</div>
	</div>

	<div class={styles.mobileOverlay} data-nav-overlay aria-hidden="true">
		<div class={styles.overlayInner}>
			<header class={styles.overlayHeader}>
				<a class={styles.overlayLogo} href={homeHref} aria-label={navCopy.home}>
					<img
						class={styles.overlayLogoImage}
						src="/images/Logotype-menu.svg"
						alt="Gea"
						loading="eager"
						decoding="async"
					/>
				</a>
				<button
					class={styles.overlayClose}
					type="button"
					aria-label={navCopy.close}
					data-overlay-close
				>
					<span aria-hidden="true">×</span>
				</button>
			</header>

			<nav class={styles.overlayNav} aria-label={navCopy.mobile}>
				{
					mobileLinks.map((link) => (
						<a
							class={styles.overlayLink}
							href={link.href}
							data-overlay-link
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<footer class={styles.overlayFooter} aria-label={navCopy.overlay}>
				<p class={styles.overlayStatement}>
					{footerCopy.statement}
				</p>
			</footer>
		</div>
	</div>
</header>

<script>
	const nav = document.querySelector("[data-site-nav]") as HTMLElement | null;

	if (nav) {
		const toggle = nav.querySelector(
			"[data-nav-toggle]",
		) as HTMLButtonElement | null;
		const overlay = nav.querySelector(
			"[data-nav-overlay]",
		) as HTMLElement | null;
		const overlayClose = nav.querySelector(
			"[data-overlay-close]",
		) as HTMLButtonElement | null;
		const overlayLinks = Array.from(
			nav.querySelectorAll("[data-overlay-link]"),
		) as HTMLAnchorElement[];
		const languageLinks = Array.from(
			nav.querySelectorAll("[data-language-link]"),
		) as HTMLAnchorElement[];

		const updateScrolledState = () => {
			nav.dataset.scrolled = window.scrollY > 12 ? "true" : "false";
		};

		const setMenuState = (open: boolean) => {
			if (!toggle || !overlay) return;

			nav.dataset.menuOpen = open ? "true" : "false";
			toggle.setAttribute("aria-expanded", open ? "true" : "false");
			overlay.setAttribute("aria-hidden", open ? "false" : "true");
			document.body.style.overflow = open ? "hidden" : "";
		};

		toggle?.addEventListener("click", (event) => {
			event.preventDefault();
			event.stopPropagation();

			setMenuState(nav.dataset.menuOpen !== "true");
		});

		overlayClose?.addEventListener("click", () => {
			setMenuState(false);
		});

		[...overlayLinks, ...languageLinks].forEach((link) => {
			link.addEventListener("click", () => {
				setMenuState(false);
			});
		});

		window.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && nav.dataset.menuOpen === "true") {
				setMenuState(false);
			}
		});

		window.addEventListener("scroll", updateScrolledState, {
			passive: true,
		});
		updateScrolledState();
		setMenuState(false);
	}
</script>
