---
import styles from './SiteNav.module.css';

interface Props {
	overlayHero?: boolean;
}

const { overlayHero = false } = Astro.props as Props;

const navLinks = [
	{ href: '/#services', label: 'Services' },
	{ href: '/proyectos', label: 'Projects' },
	{ href: '/#about', label: 'Studio' },
	{ href: '/#contact', label: 'Contact' }
];
---

<header
	class={styles.nav}
	data-site-nav
	data-overlay-hero={overlayHero ? 'true' : 'false'}
	data-scrolled={overlayHero ? 'false' : 'true'}
>
	<div class={styles.inner}>
		<a class={styles.logo} href="/" aria-label="Gea home">
			<img src="/images/Logotype.svg" alt="Gea" loading="eager" decoding="async" />
		</a>

		<nav class={styles.desktopNav} aria-label="Main navigation">
			{
				navLinks.map((link) => (
					<a class={styles.desktopLink} href={link.href}>{link.label}</a>
				))
			}
		</nav>

		<button
			class={styles.menuButton}
			type="button"
			aria-label="Open menu"
			aria-expanded="false"
			data-nav-toggle
		>
			<span class={styles.menuIconOpen} aria-hidden="true">☰</span>
			<span class={styles.menuIconClose} aria-hidden="true">✕</span>
		</button>
	</div>

	<div class={styles.mobileOverlay} data-nav-overlay hidden>
		<div class={styles.overlayInner}>
			<div class={styles.overlayNavWrap}>
				<nav class={styles.overlayNav} aria-label="Mobile navigation">
					{
						navLinks.map((link) => (
							<a class={styles.overlayLink} href={link.href} data-overlay-link>
								{link.label}
							</a>
						))
					}
				</nav>
			</div>

			<footer class={styles.overlayFooter} aria-label="Overlay footer">
				<p class={styles.overlayStatement}>Creating visual universes for brands.</p>
				<div class={styles.languageSelector} role="group" aria-label="Language selector">
					<button class={`${styles.languageOption} ${styles.languageOptionActive}`} type="button" data-lang="en" aria-pressed="true">
						EN
					</button>
					<span class={styles.languageDivider} aria-hidden="true">/</span>
					<button class={styles.languageOption} type="button" data-lang="es" aria-pressed="false">
						ES
					</button>
				</div>
			</footer>
		</div>
	</div>
</header>

<script>
	const nav = document.querySelector('[data-site-nav]') as HTMLElement | null;

	if (nav) {
		const overlayHeroMode = nav.dataset.overlayHero === 'true';
		const toggleButton = nav.querySelector('[data-nav-toggle]') as HTMLButtonElement | null;
		const overlay = nav.querySelector('[data-nav-overlay]') as HTMLElement | null;
		const overlayLinks = Array.from(nav.querySelectorAll('[data-overlay-link]')) as HTMLAnchorElement[];
		let menuOpen = false;

		const updateScrollState = () => {
			nav.dataset.scrolled = overlayHeroMode ? (window.scrollY > 12 ? 'true' : 'false') : 'true';
		};

		const setMenuState = (open: boolean) => {
			if (!overlay || !toggleButton) return;
			menuOpen = open;
			nav.dataset.menuOpen = open ? 'true' : 'false';
			overlay.hidden = !open;
			toggleButton.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggleButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			document.body.style.overflow = open ? 'hidden' : '';
		};

		toggleButton?.addEventListener('click', () => {
			setMenuState(!menuOpen);
		});

		overlayLinks.forEach((link) => {
			link.addEventListener('click', () => {
				setMenuState(false);
			});
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menuOpen) {
				setMenuState(false);
			}
		});

		window.addEventListener('scroll', updateScrollState, { passive: true });
		updateScrollState();
	}
</script>
