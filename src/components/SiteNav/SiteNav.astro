---
import styles from './SiteNav.module.css';
import { getLanguageSwitchPath, getLocalizedPath, menuFooterCopy, navLabels, type Locale } from '../../i18n/site';

interface Props {
	overlayHero?: boolean;
	locale: Locale;
	pathname: string;
}

const { overlayHero = false, locale, pathname } = Astro.props as Props;

const labels = navLabels[locale];
const footerCopy = menuFooterCopy[locale];
const homeHref = locale === 'en' ? '/en' : '/';

const esHomePath = '/';
const esProjectsPath = '/proyectos';
const navLinks = [
	{ href: getLocalizedPath(locale, '/#services'), label: labels.services },
	{ href: getLocalizedPath(locale, esProjectsPath), label: labels.projects },
	{ href: getLocalizedPath(locale, '/#about'), label: labels.studio },
	{ href: getLocalizedPath(locale, '/#contact'), label: labels.contact }
];

const spanishSwitchPath = getLanguageSwitchPath(pathname, 'es');
const englishSwitchPath = getLanguageSwitchPath(pathname, 'en');
---

<header
	class={styles.nav}
	data-site-nav
	data-overlay-hero={overlayHero ? 'true' : 'false'}
	data-scrolled={overlayHero ? 'false' : 'true'}
>
	<div class={styles.inner}>
		<a class={styles.logo} href={homeHref} aria-label="Gea home">
			<img class={styles.logoDefault} src="/images/Logotype.svg" alt="Gea" loading="eager" decoding="async" />
			<img class={styles.logoWhite} src="/images/Logotype-white.svg" alt="Gea" loading="eager" decoding="async" />
		</a>

		<nav class={styles.desktopNav} aria-label="Main navigation">
			{
				navLinks.map((link) => (
					<a class={styles.desktopLink} href={link.href}>{link.label}</a>
				))
			}
		</nav>

		<button
			class={styles.menuButton}
			type="button"
			aria-label="Open menu"
			aria-expanded="false"
			data-nav-toggle
		>
			<span class={styles.menuIconOpen} aria-hidden="true">☰</span>
			<span class={styles.menuIconClose} aria-hidden="true">✕</span>
		</button>
	</div>

	<div class={styles.mobileOverlay} data-nav-overlay hidden>
		<div class={styles.overlayInner}>
			<div class={styles.overlayNavWrap}>
				<nav class={styles.overlayNav} aria-label="Mobile navigation">
					{
						navLinks.map((link) => (
							<a class={styles.overlayLink} href={link.href} data-overlay-link>
								{link.label}
							</a>
						))
					}
				</nav>
			</div>

			<footer class={styles.overlayFooter} aria-label="Overlay footer">
				<p class={styles.overlayStatement}>{footerCopy.statement}</p>
				<div class={styles.languageSelector} role="group" aria-label="Language selector">
					<a
						class={`${styles.languageOption} ${locale === 'es' ? styles.languageOptionActive : ''}`}
						href={spanishSwitchPath}
						data-lang="es"
						aria-current={locale === 'es' ? 'true' : undefined}
					>
						{footerCopy.es}
					</a>
					<span class={styles.languageDivider} aria-hidden="true">/</span>
					<a
						class={`${styles.languageOption} ${locale === 'en' ? styles.languageOptionActive : ''}`}
						href={englishSwitchPath}
						data-lang="en"
						aria-current={locale === 'en' ? 'true' : undefined}
					>
						{footerCopy.en}
					</a>
				</div>
			</footer>
		</div>
	</div>
</header>

<script>
	const nav = document.querySelector('[data-site-nav]') as HTMLElement | null;

	if (nav) {
		const overlayHeroMode = nav.dataset.overlayHero === 'true';
		const toggleButton = nav.querySelector('[data-nav-toggle]') as HTMLButtonElement | null;
		const overlay = nav.querySelector('[data-nav-overlay]') as HTMLElement | null;
		const overlayLinks = Array.from(nav.querySelectorAll('[data-overlay-link]')) as HTMLAnchorElement[];
		const languageLinks = Array.from(nav.querySelectorAll('[data-lang]')) as HTMLAnchorElement[];
		let menuOpen = false;

		const updateScrollState = () => {
			nav.dataset.scrolled = overlayHeroMode ? (window.scrollY > 12 ? 'true' : 'false') : 'true';
		};

		const setMenuState = (open: boolean) => {
			if (!overlay || !toggleButton) return;
			menuOpen = open;
			nav.dataset.menuOpen = open ? 'true' : 'false';
			overlay.hidden = !open;
			toggleButton.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggleButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			document.body.style.overflow = open ? 'hidden' : '';
		};

		toggleButton?.addEventListener('click', () => {
			setMenuState(!menuOpen);
		});

		overlayLinks.forEach((link) => {
			link.addEventListener('click', () => {
				setMenuState(false);
			});
		});

		languageLinks.forEach((link) => {
			link.addEventListener('click', () => {
				setMenuState(false);
			});
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menuOpen) {
				setMenuState(false);
			}
		});

		window.addEventListener('scroll', updateScrollState, { passive: true });
		updateScrollState();
	}
</script>
