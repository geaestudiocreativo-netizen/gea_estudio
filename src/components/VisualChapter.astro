---
import styles from './VisualChapter.module.css';
import ResponsiveImage from './ResponsiveImage.astro';
import { visualChapterContent } from '../i18n/home-content';
import type { Locale } from '../i18n/site';

const imageSrc = '/images/others/Galaxia.png';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props as Props;
const content = visualChapterContent[locale];
---

<section class={styles.chapter} aria-label={content.ariaLabel} data-visual-chapter data-state="idle">
	<div class={styles.wordmarkDock} data-wordmark-dock aria-hidden="true"></div>
	<div class={styles.stickyStage}>
		<div class={styles.frame} data-visual-frame>
			<ResponsiveImage
				class={styles.image}
				src={imageSrc}
				alt=""
				loading="lazy"
				decoding="async"
				sizes="100vw"
				widths={[640, 960, 1280, 1600, 1920]}
			/>
			<p class={styles.copy} aria-hidden="true">
					<span class={styles.mainLineA}>{content.heading}</span>
				<span class={styles.mainLineB}>
						{content.lines.map((line) => <span class={styles.mainLineBLine}>{line}</span>)}
				</span>
			</p>
		</div>
	</div>
</section>

<script is:inline>
	const chapters = document.querySelectorAll('[data-visual-chapter]');

	chapters.forEach((chapter) => {
		if (!(chapter instanceof HTMLElement)) {
			return;
		}

		const frame = chapter.querySelector('[data-visual-frame]');
		if (!(frame instanceof HTMLElement)) {
			return;
		}

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (prefersReducedMotion) {
			chapter.dataset.state = 'done';
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						chapter.dataset.state = 'entered';
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.24, rootMargin: '0px 0px -6% 0px' }
		);

		observer.observe(chapter);
	});
</script>
