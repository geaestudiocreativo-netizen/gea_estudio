---
import type { Locale } from '../i18n/site';

interface Props {
	locale?: Locale;
	embedded?: boolean;
}

const { locale = 'es', embedded = false } = Astro.props as Props;
const videos = [
	{ file: 'video-01.optimized.mp4', label: 'Filmmaking' },
	{ file: 'video-02.optimized.mp4', label: 'Photoshoot' },
	{ file: 'video-03.optimized.mp4', label: 'Contenido para IG' }
];
const label = locale === 'en' ? 'Videos' : 'Videos';
---

<section class:list={['videos-section', embedded && 'videos-section--embedded']} aria-labelledby="videos-title">
	<h2 id="videos-title" class="sr-only">{label}</h2>
	<div class="videos-section__row">
		{videos.map((video, index) => (
			<div class="videos-section__card">
				<video
					class="videos-section__video"
					data-video-src={`/images/videos/${video.file}`}
					autoplay
					loop
					muted
					playsinline
					preload="none"
					aria-label={`${label} ${index + 1}`}
				/>
				<span class="videos-section__label">{video.label}</span>
			</div>
		))}
	</div>
</section>

<script>
	const videos = document.querySelectorAll<HTMLVideoElement>('.videos-section__video');
	const loadVideo = (video: HTMLVideoElement) => {
		const source = video.dataset.videoSrc;
		if (!source || video.src) return;
		video.src = source;
		video.load();
		void video.play().catch(() => undefined);
	};
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				const video = entry.target as HTMLVideoElement;
				loadVideo(video);
				observer.unobserve(video);
			}
		});
	}, { rootMargin: '300px 0px' });

	videos.forEach((video) => {
		video.muted = true;
		video.defaultMuted = true;
		observer.observe(video);
	});
</script>

<style>
	.videos-section {
		width: 100%;
		padding-block: clamp(96px, 14vw, 220px);
		background: #f8f8f8;
	}

	.videos-section--embedded {
		padding-block: clamp(24px, 4vw, 56px);
		background: transparent;
	}

	.videos-section--embedded .videos-section__row {
		width: 100%;
		padding: 0 clamp(16px, 4vw, 64px);
	}

	.videos-section__row {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(12px, 2vw, 28px);
		padding: clamp(36px, 5vw, 72px) clamp(16px, 4vw, 64px);
	}

	.videos-section__video {
		display: block;
		width: 100%;
		aspect-ratio: 9 / 16;
		object-fit: cover;
		background: #f3f0ee;
	}

	.videos-section__card {
		position: relative;
		overflow: hidden;
		border-radius: 8px;
		background: #f3f0ee;
		box-shadow:
			0 2px 4px rgb(15 17 21 / 10%),
			0 12px 24px rgb(15 17 21 / 14%),
			inset 0 0 0 1px rgb(255 255 255 / 28%);
		transform: translateZ(0);
	}

	.videos-section__label {
		position: absolute;
		left: clamp(14px, 2vw, 28px);
		bottom: clamp(14px, 2vw, 28px);
		z-index: 1;
		color: #fff;
		font-family: 'Satoshi', sans-serif;
		font-size: clamp(12px, 1.35vw, 18px);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0;
		text-shadow: 0 2px 10px rgb(0 0 0 / 45%);
	}

	@media (max-width: 600px) {
		.videos-section__row {
			gap: 8px;
			padding: 24px 8px;
		}

		.videos-section__card {
			border-radius: 6px;
		}
	}

	@media (min-width: 1024px) {
		.videos-section__row {
			width: 78%;
			margin-inline: auto;
		}

		.videos-section--embedded .videos-section__row {
			width: 78%;
			padding-inline: 0;
		}
	}
</style>
