---
import type { Locale } from '../i18n/site';
import { serviceMarqueeContent } from '../i18n/home-content';

interface Props {
	locale?: Locale;
}

const { locale = 'es' } = Astro.props as Props;
const content = serviceMarqueeContent[locale];
const films = [
	{ src: '/images/videos/mercurio-campana.optimized.mp4', poster: '/images/videos/mercurio-campana-poster.jpg', ...content.films[0] },
	{ src: '/images/videos/video-01.optimized.mp4', poster: undefined, ...content.films[1] },
	{ src: '/images/videos/video-02.optimized.mp4', poster: undefined, ...content.films[2] },
	{ src: '/images/videos/video-03.optimized.mp4', poster: undefined, ...content.films[3] }
];
---

<section class="serviceMarquee" aria-labelledby="brand-statement-title">
	<div class="serviceMarquee__content">
		<div class="serviceMarquee__top">
			<div class="serviceMarquee__statement">
				<p class="serviceMarquee__eyebrow">{content.eyebrow}</p>
				<h2 id="brand-statement-title">
					{content.headline.map((line, i) => (
						<span class:list={['serviceMarquee__headlineLine', i === content.headline.length - 1 && 'is-accent']}>{line}</span>
					))}
				</h2>
				<p class="serviceMarquee__support">{content.support}</p>
			</div>

			<div class="serviceMarquee__grid">
				{films.map((film) => (
					<figure class="serviceMarquee__film">
						<div class="serviceMarquee__frame">
							<video
								class="serviceMarquee__video"
								data-video-src={film.src}
								poster={film.poster}
								autoplay
								loop
								muted
								playsinline
								preload="none"
								aria-label={film.meta ? `${film.title} · ${film.meta}` : film.title}
							/>
						</div>
						<figcaption class="serviceMarquee__caption">
							<span class="serviceMarquee__title">{film.title}</span>
							{film.meta && <span class="serviceMarquee__meta">{film.meta}</span>}
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	const videos = document.querySelectorAll<HTMLVideoElement>('.serviceMarquee__video');
	const loadVideo = (video: HTMLVideoElement) => {
		const source = video.dataset.videoSrc;
		if (!source || video.src) return;
		video.src = source;
		video.load();
		void video.play().catch(() => undefined);
	};
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				const video = entry.target as HTMLVideoElement;
				loadVideo(video);
				observer.unobserve(video);
			}
		});
	}, { rootMargin: '300px 0px' });

	videos.forEach((video) => {
		video.muted = true;
		video.defaultMuted = true;
		observer.observe(video);
	});

	// Entrada suave: el titular línea a línea y los vídeos uno detrás de otro.
	// Cada bloque se anima cuando él mismo entra bien en pantalla (no la sección entera),
	// para que la animación se vea y no ocurra antes de llegar.
	const section = document.querySelector<HTMLElement>('.serviceMarquee');
	if (section) {
		section.classList.add('is-animated');
		const blocks = section.querySelectorAll<HTMLElement>('.serviceMarquee__statement, .serviceMarquee__grid');
		const reveal = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-in');
					reveal.unobserve(entry.target);
				}
			});
		}, { threshold: 0.2, rootMargin: '0px 0px -18% 0px' });
		blocks.forEach((block) => reveal.observe(block));
	}
</script>

<style>
	.serviceMarquee {
		/* Colores de la tarjeta de visita: fondo espresso + verde oliva dorado */
		--sm-bg: #160c07;
		--sm-ink: #f5ecdf;
		--sm-muted: rgb(245 236 223 / 55%);
		--sm-accent: #ada175;
		--content-width: 78%;
		position: relative;
		z-index: 4;
		width: 100vw;
		min-height: 0;
		margin-left: calc(50% - 50vw);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: var(--sm-bg);
		padding: clamp(120px, 14vw, 220px) clamp(16px, 5vw, 72px);
		box-sizing: border-box;
	}

	.serviceMarquee__content {
		width: var(--content-width);
		display: flex;
		flex-direction: column;
		gap: clamp(56px, 7vw, 112px);
	}

	.serviceMarquee__top {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(48px, 6vw, 80px);
	}

	.serviceMarquee__statement {
		color: var(--sm-ink);
		font-family: 'Satoshi', sans-serif;
		text-align: left;
	}

	.serviceMarquee__eyebrow {
		margin: 0 0 clamp(24px, 3vw, 44px);
		color: var(--sm-ink);
		font-size: clamp(13px, 1.1vw, 16px);
		font-weight: 300;
		line-height: 1;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.serviceMarquee__statement h2 {
		margin: 0;
		font-size: clamp(30px, 10vw, 62px);
		font-weight: 700;
		line-height: 0.96;
		letter-spacing: 0;
	}

	.serviceMarquee__headlineLine {
		display: block;
		white-space: nowrap;
	}

	.serviceMarquee__headlineLine.is-accent {
		color: var(--sm-accent);
	}

	.serviceMarquee__support {
		max-width: 34ch;
		margin: clamp(28px, 4vw, 56px) 0 0;
		color: var(--sm-muted);
		font-size: clamp(14px, 3.8vw, 16px);
		font-weight: 300;
		line-height: 1.45;
	}

	.serviceMarquee__grid {
		/* Ancho limitado por el alto de pantalla para que los 4 vídeos quepan a la vez */
		width: min(100%, calc((100svh - 270px) * 0.5625));
		margin-inline: auto;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(20px, 2.2vw, 32px) clamp(12px, 1.4vw, 20px);
	}

	.serviceMarquee__film {
		margin: 0;
	}

	.serviceMarquee__frame {
		position: relative;
		overflow: hidden;
		border-radius: 4px;
		background: #24180f;
		transform: translateZ(0);
	}

	.serviceMarquee__video {
		display: block;
		width: 100%;
		aspect-ratio: 9 / 16;
		object-fit: cover;
	}

	.serviceMarquee__caption {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 2px 8px;
		margin-top: 10px;
		font-family: 'Satoshi', sans-serif;
		font-size: clamp(11px, 0.9vw, 13px);
		line-height: 1.3;
	}

	.serviceMarquee__title {
		color: var(--sm-accent);
	}

	.serviceMarquee__meta {
		color: var(--sm-muted);
		font-style: italic;
		font-weight: 300;
	}


	@media (max-width: 767px) {
		.serviceMarquee {
			--content-width: 100%;
		}


	}

	@media (min-width: 768px) {
		.serviceMarquee__top {
			grid-template-columns: minmax(0, 1fr) min(360px, calc((100svh - 270px) * 0.5625));
			column-gap: clamp(48px, 7vw, 120px);
			align-items: center;
		}

		.serviceMarquee__grid {
			width: 100%;
		}

		.serviceMarquee__statement {
			padding-bottom: 0;
		}

		.serviceMarquee__statement h2 {
			font-size: clamp(36px, 4.6vw, 76px);
		}

		.serviceMarquee__support {
			font-size: clamp(15px, 1.3vw, 19px);
		}

	}
	/* ---------- Animación de entrada ---------- */
	@media (prefers-reduced-motion: no-preference) {
		.serviceMarquee.is-animated .serviceMarquee__eyebrow,
		.serviceMarquee.is-animated .serviceMarquee__headlineLine,
		.serviceMarquee.is-animated .serviceMarquee__support,
		.serviceMarquee.is-animated .serviceMarquee__film {
			opacity: 0;
			transform: translateY(40px);
			transition: opacity 1100ms cubic-bezier(0.22, 1, 0.36, 1), transform 1100ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		.serviceMarquee.is-animated .serviceMarquee__film {
			transform: translateY(60px) scale(0.94);
		}

		.serviceMarquee.is-animated .is-in .serviceMarquee__eyebrow,
		.serviceMarquee.is-animated .is-in .serviceMarquee__headlineLine,
		.serviceMarquee.is-animated .is-in .serviceMarquee__support,
		.serviceMarquee.is-animated .is-in .serviceMarquee__film {
			opacity: 1;
			transform: none;
		}

		.serviceMarquee.is-animated .is-in .serviceMarquee__headlineLine:nth-child(2) { transition-delay: 120ms; }
		.serviceMarquee.is-animated .is-in .serviceMarquee__headlineLine:nth-child(3) { transition-delay: 240ms; }
		.serviceMarquee.is-animated .is-in .serviceMarquee__headlineLine:nth-child(4) { transition-delay: 360ms; }
		.serviceMarquee.is-animated .is-in .serviceMarquee__support { transition-delay: 480ms; }
		.serviceMarquee.is-animated .is-in .serviceMarquee__film:nth-child(1) { transition-delay: 200ms; }
		.serviceMarquee.is-animated .is-in .serviceMarquee__film:nth-child(2) { transition-delay: 350ms; }
		.serviceMarquee.is-animated .is-in .serviceMarquee__film:nth-child(3) { transition-delay: 500ms; }
		.serviceMarquee.is-animated .is-in .serviceMarquee__film:nth-child(4) { transition-delay: 650ms; }

		/* Al pasar el ratón, el vídeo se acerca un poco */
		.serviceMarquee__video {
			transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		@media (hover: hover) and (pointer: fine) {
			.serviceMarquee__film:hover .serviceMarquee__video {
				transform: scale(1.05);
			}
		}
	}
</style>
