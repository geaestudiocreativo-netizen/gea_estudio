---
import type { Locale } from '../i18n/site';
import VideosSection from './VideosSection.astro';

interface Props {
	locale?: Locale;
}

const { locale = 'es' } = Astro.props as Props;
---


<section class="serviceMarquee" aria-labelledby="brand-statement-title">
	<div class="serviceMarquee__statement">
		<p class="serviceMarquee__eyebrow">UNA MARCA NO SOLO</p>
		<h2 id="brand-statement-title">SE DISEÑA.<br />SE CONSTRUYE.</h2>
		<p class="serviceMarquee__support">A través de la dirección creativa y el branding damos forma al universo visual de tu marca.</p>
	</div>
	<VideosSection locale={locale} embedded />
</section>

<style>
	.serviceMarquee {
		position: relative;
		z-index: 4;
		width: 100vw;
		height: auto;
		min-height: 100svh;
		margin-left: calc(50% - 50vw);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: #160c07;
		flex-direction: column;
		gap: clamp(64px, 8vw, 120px);
		padding-block: clamp(112px, 14vw, 208px);
	}

	.serviceMarquee__statement {
		width: min(78%, 1120px);
		margin: 0 auto;
		color: #f5ecdf;
		font-family: 'Satoshi', sans-serif;
		text-align: left;
	}

	.serviceMarquee__eyebrow {
		margin: 0 0 clamp(28px, 4vw, 52px);
		color: #f5ecdf;
		font-size: clamp(14px, 1.25vw, 18px);
		font-weight: 300;
		line-height: 1;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.serviceMarquee__statement h2 {
		margin: 0;
		font-size: clamp(42px, 6.5vw, 96px);
		font-weight: 700;
		line-height: 0.96;
		letter-spacing: 0;
	}

	.serviceMarquee__support {
		max-width: 100%;
		margin: clamp(36px, 5vw, 72px) 0 0;
		font-size: clamp(18px, 1.5vw, 22px);
		font-weight: 300;
		line-height: 1.35;
		letter-spacing: 0;
	}

	.serviceMarquee .videos-section--embedded {
		padding-block: 0;
	}

	.serviceMarquee .videos-section--embedded .videos-section__row {
		padding-block: 0;
	}

	@media (min-width: 1024px) {
		.serviceMarquee .videos-section--embedded .videos-section__row {
			padding-block: 0;
		}
	}

	@media (max-width: 767px) {
		.serviceMarquee__statement {
			width: calc(100% - 32px);
		}

		.serviceMarquee__eyebrow {
			margin-bottom: 28px;
		}

		.serviceMarquee__statement h2 {
			font-size: clamp(38px, 10.5vw, 62px);
		}
	}
</style>
