---
import type { Locale } from '../i18n/site';
import { serviceMarqueeContent } from '../i18n/home-content';

interface Props {
	locale?: Locale;
}

const { locale = 'es' } = Astro.props as Props;
const content = serviceMarqueeContent[locale];
const featured = {
	src: '/images/videos/mercurio-campana.optimized.mp4',
	poster: '/images/videos/mercurio-campana-poster.jpg',
	...content.featured
};
---

<section class="serviceMarquee" aria-labelledby="brand-statement-title">
	<div class="serviceMarquee__content">
		<div class="serviceMarquee__top">
			<div class="serviceMarquee__statement">
				<p class="serviceMarquee__eyebrow">{content.eyebrow}</p>
				<h2 id="brand-statement-title">
					{content.headline.map((line, i) => (
						<span class:list={['serviceMarquee__headlineLine', i === content.headline.length - 1 && 'is-accent']}>{line}</span>
					))}
				</h2>
				<p class="serviceMarquee__support">{content.support}</p>
			</div>

			<figure class="serviceMarquee__film serviceMarquee__film--featured">
				<div class="serviceMarquee__frame">
					<video
						class="serviceMarquee__video"
						data-video-src={featured.src}
						poster={featured.poster}
						autoplay
						loop
						muted
						playsinline
						preload="none"
						aria-label={`${featured.title} · ${featured.meta}`}
					/>
				</div>
				<figcaption class="serviceMarquee__caption">
					<span class="serviceMarquee__title">{featured.title}</span>
					<span class="serviceMarquee__meta">{featured.meta}</span>
				</figcaption>
			</figure>
		</div>
	</div>
</section>

<script>
	const videos = document.querySelectorAll<HTMLVideoElement>('.serviceMarquee__video');
	const loadVideo = (video: HTMLVideoElement) => {
		const source = video.dataset.videoSrc;
		if (!source || video.src) return;
		video.src = source;
		video.load();
		void video.play().catch(() => undefined);
	};
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				const video = entry.target as HTMLVideoElement;
				loadVideo(video);
				observer.unobserve(video);
			}
		});
	}, { rootMargin: '300px 0px' });

	videos.forEach((video) => {
		video.muted = true;
		video.defaultMuted = true;
		observer.observe(video);
	});
</script>

<style>
	.serviceMarquee {
		/* Colores de la tarjeta de visita: fondo espresso + verde oliva dorado */
		--sm-bg: #160c07;
		--sm-ink: #f5ecdf;
		--sm-muted: rgb(245 236 223 / 55%);
		--sm-accent: #ada175;
		--content-width: 78%;
		position: relative;
		z-index: 4;
		width: 100vw;
		min-height: 0;
		margin-left: calc(50% - 50vw);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: var(--sm-bg);
		padding: clamp(120px, 14vw, 220px) clamp(16px, 5vw, 72px);
		box-sizing: border-box;
	}

	.serviceMarquee__content {
		width: var(--content-width);
		display: flex;
		flex-direction: column;
		gap: clamp(56px, 7vw, 112px);
	}

	.serviceMarquee__top {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(48px, 6vw, 80px);
	}

	.serviceMarquee__statement {
		color: var(--sm-ink);
		font-family: 'Satoshi', sans-serif;
		text-align: left;
	}

	.serviceMarquee__eyebrow {
		margin: 0 0 clamp(24px, 3vw, 44px);
		color: var(--sm-ink);
		font-size: clamp(13px, 1.1vw, 16px);
		font-weight: 300;
		line-height: 1;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.serviceMarquee__statement h2 {
		margin: 0;
		font-size: clamp(30px, 10vw, 62px);
		font-weight: 700;
		line-height: 0.96;
		letter-spacing: 0;
	}

	.serviceMarquee__headlineLine {
		display: block;
		white-space: nowrap;
	}

	.serviceMarquee__headlineLine.is-accent {
		color: var(--sm-accent);
	}

	.serviceMarquee__support {
		max-width: 34ch;
		margin: clamp(28px, 4vw, 56px) 0 0;
		color: var(--sm-muted);
		font-size: clamp(14px, 3.8vw, 16px);
		font-weight: 300;
		line-height: 1.45;
	}

	.serviceMarquee__film {
		margin: 0;
	}

	.serviceMarquee__frame {
		position: relative;
		overflow: hidden;
		border-radius: 4px;
		background: #24180f;
		transform: translateZ(0);
	}

	.serviceMarquee__video {
		display: block;
		width: 100%;
		aspect-ratio: 9 / 16;
		object-fit: cover;
	}

	.serviceMarquee__caption {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 10px;
		margin-top: 14px;
		font-family: 'Satoshi', sans-serif;
		font-size: clamp(12px, 1.05vw, 15px);
		line-height: 1.3;
	}

	.serviceMarquee__title {
		color: var(--sm-accent);
	}

	.serviceMarquee__meta {
		color: var(--sm-muted);
		font-style: italic;
		font-weight: 300;
	}


	@media (max-width: 767px) {
		.serviceMarquee {
			--content-width: 100%;
		}

		.serviceMarquee__film--featured {
			width: 62%;
			margin-left: auto;
		}

	}

	@media (min-width: 768px) {
		.serviceMarquee__top {
			grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
			column-gap: clamp(48px, 7vw, 120px);
			align-items: end;
		}

		.serviceMarquee__statement {
			padding-bottom: clamp(40px, 6vw, 96px);
		}

		.serviceMarquee__statement h2 {
			font-size: clamp(36px, 4.6vw, 76px);
		}

		.serviceMarquee__support {
			font-size: clamp(15px, 1.3vw, 19px);
		}

	}
</style>
