---
import type { Locale } from '../i18n/site';
import VideosSection from './VideosSection.astro';
import { serviceMarqueeContent } from '../i18n/home-content';

interface Props {
	locale?: Locale;
}

const { locale = 'es' } = Astro.props as Props;
const content = serviceMarqueeContent[locale];
---


<section class="serviceMarquee" aria-labelledby="brand-statement-title">
	<div class="serviceMarquee__content">
		<div class="serviceMarquee__statement">
			<p class="serviceMarquee__eyebrow">{content.eyebrow}</p>
			<h2 id="brand-statement-title">
				{content.headline.map((line) => <span class="serviceMarquee__headlineLine">{line}</span>)}
			</h2>
			<p class="serviceMarquee__support">{content.support}</p>
		</div>
		<VideosSection locale={locale} embedded />
	</div>
</section>

<style>
	.serviceMarquee {
		--content-width: 78%;
		position: relative;
		z-index: 4;
		width: 100vw;
		height: auto;
		min-height: 100svh;
		margin-left: calc(50% - 50vw);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: #160c07;
		flex-direction: column;
		padding: clamp(160px, 18vw, 280px) clamp(16px, 5vw, 72px);
		box-sizing: border-box;
	}

	.serviceMarquee__content {
		width: var(--content-width);
		display: flex;
		flex-direction: column;
		gap: clamp(64px, 8vw, 120px);
	}

	.serviceMarquee__statement {
		width: 100%;
		color: #f5ecdf;
		font-family: 'Satoshi', sans-serif;
		text-align: left;
	}

	.serviceMarquee__eyebrow {
		margin: 0 0 clamp(28px, 4vw, 52px);
		color: #f5ecdf;
		font-size: clamp(14px, 1.25vw, 18px);
		font-weight: 300;
		line-height: 1;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.serviceMarquee__statement h2 {
		margin: 0;
		font-size: clamp(42px, 6.5vw, 96px);
		font-weight: 700;
		line-height: 0.96;
		letter-spacing: 0;
	}

	.serviceMarquee__headlineLine {
		display: block;
		white-space: nowrap;
	}

	.serviceMarquee__support {
		max-width: 100%;
		margin: clamp(36px, 5vw, 72px) 0 0;
		font-size: clamp(14px, 2.2vw, 19px);
		font-weight: 300;
		line-height: 1.35;
		letter-spacing: 0;
	}

	.serviceMarquee :global(.videos-section--embedded) {
		width: 100%;
		padding-block: 0;
	}

	.serviceMarquee :global(.videos-section--embedded .videos-section__row) {
		width: 100%;
		padding-block: 0;
		padding-inline: 0;
		margin-inline: 0;
	}

	@media (max-width: 900px) {
		.serviceMarquee__support {
			font-size: clamp(12px, 3.8vw, 14px);
		}
	}

	@media (min-width: 1024px) {
		.serviceMarquee :global(.videos-section--embedded .videos-section__row) {
			padding-block: 0;
		}
	}

	@media (max-width: 767px) {
		.serviceMarquee {
			--content-width: 100%;
		}

		.serviceMarquee__support {
			font-size: clamp(12px, 3.8vw, 14px);
		}

		.serviceMarquee__eyebrow {
			margin-bottom: 28px;
		}

		.serviceMarquee__statement h2 {
			font-size: clamp(30px, 10vw, 62px);
		}
	}
</style>
