---
import styles from './ProjectTabs.module.css';

interface Tab {
	id: string;
	label: string;
}

interface Props {
	sections: Tab[];
	activeTab?: string;
	ariaLabel?: string;
}

const { sections, activeTab, ariaLabel = 'Navegación de secciones del proyecto' } = Astro.props as Props;
const initialActiveTab = activeTab ?? sections[0]?.id ?? '';
---

<div
	class={styles.tabs}
	role="tablist"
	aria-label={ariaLabel}
	data-project-tabs
>
	{
		sections.map((tab, index) => (
			<button
				type="button"
				class={styles.tab}
				id={`tab-${tab.id}`}
				role="tab"
				aria-selected={tab.id === initialActiveTab ? 'true' : 'false'}
				aria-controls={`panel-${tab.id}`}
				tabindex={tab.id === initialActiveTab || (!initialActiveTab && index === 0) ? '0' : '-1'}
				data-project-tab
				data-target={tab.id}
			>
				{tab.label}
			</button>
		))
	}
</div>
