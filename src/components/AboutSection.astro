---
const aboutText =
	"Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966, when designers at Letraset and James Mosley, the librarian at St Bride Printing Library in London, took a 1914 Cicero translation and scrambled it to make dummy text for Letraset's";
---

<section class="mt-[170px] w-full bg-[#f8f8f8] px-[24px] pb-[72px] md:mt-[210px] md:px-[32px] md:pb-[92px] lg:mt-[240px] lg:px-[68px] lg:pb-[110px]" aria-labelledby="about-title">
	<div class="mx-auto w-full max-w-[1120px]">
		<div class="relative overflow-hidden">
			<img
				src="/images/about_image.png"
				alt="Creative director reviewing editorial color and print material"
				class="block w-full object-cover aspect-[704/860]"
				loading="lazy"
				decoding="async"
			/>
			<h2
				id="about-title"
				class="absolute right-[24px] top-[9%] m-0 font-['Krona_One'] text-[24px] font-normal uppercase leading-none tracking-[0.1em] text-[#0f1115] md:right-[34px] md:text-[33px] lg:right-[42px] lg:text-[52px]"
			>
				SOBRE GEA
			</h2>
		</div>

		<p class="mt-[30px] max-w-[66ch] font-['Satoshi'] text-[18px] leading-[1.42] tracking-[0.02em] text-[#2a2d32] md:mt-[36px] md:text-[19px] lg:text-[21px]">
			{aboutText}
		</p>
	</div>
</section>
