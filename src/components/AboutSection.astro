---
import buttonStyles from './PrimaryButton/PrimaryButton.module.css';
import PrimaryButton from './PrimaryButton/PrimaryButton.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { aboutSectionContent } from '../i18n/home-content';
import { getLocalizedPath, type Locale } from '../i18n/site';

interface Props {
	locale?: Locale;
}

const { locale = 'es' } = Astro.props as Props;
const content = aboutSectionContent[locale];

const segmentStarts =
	locale === 'es'
		? [
				'Soy Ángela Contreras,',
				'ingeniera de formación y directora creativa de Gea.',
				'Tras varios años trabajando en tecnología,',
				'encontré en el diseño mi verdadera forma de crear.',
				'Hoy ayudo a marcas y emprendedores a construir una identidad coherente a través del branding, el diseño web, la fotografía y la dirección creativa.',
				
			]
		: [
				'I am Angela Contreras,',
				'an engineer by training and the creative director of Gea.',
				'After several years in technology,',
				'I found in design my truest way of creating.',
				'Today I help brands and founders build coherent identities through branding, web design, photography and creative direction.',
				
			];

const aboutSegments = segmentStarts.map((start, index) => {
	const startIndex = content.text.indexOf(start);
	const nextStart = segmentStarts[index + 1];
	const endIndex = nextStart ? content.text.indexOf(nextStart, startIndex) : content.text.length;

	return content.text.slice(startIndex, endIndex).trim();
});

---

<section id="about" class="about-section w-full -mt-[32px] bg-[#f8f8f8] bg-cover bg-center bg-[url('/images/about/about_image.png')] px-[24px] pt-[96px] pb-[96px] md:-mt-[32px] md:px-[32px] md:pt-[120px] md:pb-[112px] lg:-mt-[40px] lg:min-h-[100svh] lg:px-[68px] lg:pt-[184px] lg:pb-[128px]" aria-labelledby="about-title">
	<div class="mx-auto w-full max-w-[1120px] lg:min-h-[calc(100svh-312px)] lg:max-w-none lg:grid lg:grid-cols-2 lg:gap-x-0">
		<div class="relative overflow-hidden lg:contents">
			<ResponsiveImage
				src="/images/about/about_image.png"
				alt="Creative director reviewing editorial color and print material"
				class="hidden w-full object-cover aspect-[704/860] lg:col-start-2 lg:h-full lg:aspect-auto"
				loading="lazy"
				decoding="async"
				sizes="(max-width: 1120px) 100vw, 1120px"
				widths={[640, 960, 1280, 1600]}
			/>
			<h2
				id="about-title"
				class="about-title m-0 font-['Panchang'] text-[24px] font-black uppercase leading-[0.74] tracking-[0.01em] text-[#0f1115] md:text-[33px] lg:text-[84px]"
			>
				<a href={getLocalizedPath(locale, '/#about')} aria-label={content.titleAria} style="color: inherit; text-decoration: none;"><span>Sobre</span> <span>Gea</span></a>
			</h2>
		</div>

		<div class="about-side lg:flex lg:min-h-full lg:flex-col lg:justify-between">
			<div class="about-copy mt-[32px] md:mt-[40px] lg:mt-0">
				<p class="about-copy__label">{aboutSegments[0]} {aboutSegments[1]}</p>
				<p class="about-copy__transition">{aboutSegments[2]} {aboutSegments[3]}</p>
				<p class="about-copy__body">{aboutSegments[4]}</p>
			</div>

			<div id="contact" class="mt-[48px] flex flex-col items-center text-center lg:mt-auto lg:items-start lg:text-left">
				<h3 class="m-0 font-['Satoshi'] text-[18px] font-normal tracking-[0.02em] text-[#2a2d32] md:text-[19px] lg:text-[28px]">{content.contactTitle}</h3>
				<PrimaryButton href={getLocalizedPath(locale, '/#contact')} label={content.contactButton} ariaLabel={content.contactButtonAria} variant="outline" className={`${buttonStyles.desktopFull} !mt-[16px]`} />
			</div>
		</div>
	</div>
</section>

<style>
	.about-copy {
		color: #2a2d32;
	}

	.about-section {
		background-image: url('/images/about/about_image.png');
		background-position: center;
		background-size: cover;
	}

	.about-section :global(img) {
		display: none;
	}

	.about-title {
		position: absolute;
		top: 9%;
		right: 24px;
	}

	.about-copy p {
		margin: 0;
	}

	.about-copy__label {
		font-family: 'Satoshi', sans-serif;
		font-size: 12px;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.about-copy__transition {
		max-width: none;
		margin-top: clamp(42px, 5vw, 72px) !important;
		font-family: 'Satoshi', sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.35;
		letter-spacing: 0.01em;
	}

	.about-copy__body {
		max-width: none;
		margin-top: clamp(48px, 6vw, 88px) !important;
		font-family: 'Satoshi', sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.35;
		letter-spacing: 0.01em;
	}

	@media (min-width: 1024px) {
		#about :global(img) {
			transform: scale(1.5);
			transform-origin: center;
		}

		.about-title {
			position: static;
			grid-area: 1 / 3 / 2 / 4 !important;
			align-self: start;
			justify-self: stretch;
			width: 100%;
			margin: 0;
			text-align: right;
		}

		.about-title span {
			display: block;
			width: max-content;
			text-align: right;
		}

		.about-title a {
		display: flex;
			flex-direction: column;
			align-items: flex-end;
			width: 100%;
			text-align: right;
		}

		.about-copy {
			width: min(100%, 440px);
			max-width: 440px;
		}

		.about-side {
			grid-column: 1 / 2;
			grid-row: 1;
			justify-content: flex-end;
		}

		.about-copy__transition {
			margin-top: 24px !important;
		}

		.about-copy__body {
			margin-top: 32px !important;
		}

		.about-copy__transition,
		.about-copy__body {
			font-size: 20px;
		}

		.about-copy__label {
			font-size: 16px;
		}

		#contact {
			margin-top: 32px !important;
			width: min(100%, 440px);
		}
	}

	@media (max-width: 639px) {
		.about-title {
			line-height: 0.84;
			letter-spacing: 0;
		}

		#about :global(img) {
			width: 50% !important;
			max-width: none;
		}

		#contact :global(a) {
			border: 0;
			background: #111111;
			color: #f3f0ee;
		}

		#contact {
			margin-top: 72px !important;
		}

		.about-copy__transition {
			margin-top: 24px !important;
		}

		.about-copy__body {
			margin-top: 24px !important;
		}

	}
</style>
