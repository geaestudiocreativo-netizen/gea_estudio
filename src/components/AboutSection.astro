---
import buttonStyles from './PrimaryButton/PrimaryButton.module.css';
import PrimaryButton from './PrimaryButton/PrimaryButton.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { aboutSectionContent } from '../i18n/home-content';
import { getLocalizedPath, type Locale } from '../i18n/site';

interface Props {
	locale?: Locale;
}

const { locale = 'es' } = Astro.props as Props;
const content = aboutSectionContent[locale];

---

<section id="about" class="about-section w-full -mt-[32px] bg-[#f8f8f8] px-[24px] pt-[96px] pb-[96px] md:-mt-[32px] md:px-[32px] md:pt-[120px] md:pb-[112px] lg:-mt-[40px] lg:px-[68px] lg:pt-[184px] lg:pb-[128px]" aria-labelledby="about-title">
	<div class="mx-auto w-full max-w-[900px]">
		<div class="about-visual-wrap relative overflow-hidden">
			<ResponsiveImage
				src="/images/about/about_image.png"
				alt="Creative director reviewing editorial color and print material"
				class="about-portrait mx-auto w-full object-cover aspect-[704/860]"
				loading="lazy"
				decoding="async"
				sizes="(max-width: 1120px) 100vw, 1120px"
				widths={[640, 960, 1280, 1600]}
			/>
			<h2
				id="about-title"
				class="about-title"
			>
				<a href={getLocalizedPath(locale, '/#about')} aria-label={content.titleAria} style="color: inherit; text-decoration: none;"><span>Sobre</span> <span>Gea</span></a>
			</h2>
			<h3 class="about-mobile-name" aria-label="Ángela Contreras">Ángela Contreras</h3>
		</div>

		<div class="about-side">
			<div class="about-copy mt-[32px] md:mt-[40px]">
				<p class="about-copy__label">{content.intro}<br />{content.introSecondLine}</p>
				<p class="about-copy__transition">{content.context}</p>
				<p class="about-copy__body">{content.statement} {content.body} {content.disciplines}</p>
			</div>

			<div id="contact" class="mt-[48px] flex flex-col items-center text-center">
				<h3 class="m-0 font-['Satoshi'] text-[18px] font-normal tracking-[0.02em] text-[#2a2d32] md:text-[19px]">{content.contactTitle}</h3>
				<PrimaryButton href={getLocalizedPath(locale, '/#contact')} label={content.contactButton} ariaLabel={content.contactButtonAria} variant="outline" className={`${buttonStyles.desktopFull} !mt-[16px]`} />
			</div>
		</div>
	</div>
</section>

<style>
	.about-copy {
		width: min(100%, 760px);
		margin-inline: auto;
		color: #2a2d32;
	}

	.about-mobile-name {
		display: block;
		width: 100%;
		margin: 28px 0 0;
		padding: 0;
		text-align: center;
		font-family: 'Panchang', sans-serif;
		font-size: clamp(20px, 7.2vw, 40px);
		font-weight: 500;
		line-height: 0.95;
		letter-spacing: 0;
		white-space: normal;
		color: #0f1115;
		text-transform: none;
	}

	.about-visual-wrap {
		overflow: hidden;
	}

	.about-portrait {
		display: block;
		margin-inline: auto;
		width: min(36vw, 260px);
	}

	.about-title {
		display: none;
	}

	.about-copy p {
		margin: 0;
	}

	.about-copy__label {
		font-family: 'Satoshi', sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.35;
		letter-spacing: 0.01em;
	}

	.about-copy__transition {
		max-width: none;
		margin-top: 24px !important;
		font-family: 'Satoshi', sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.35;
		letter-spacing: 0.01em;
	}

	.about-copy__body {
		max-width: none;
		margin-top: 24px !important;
		font-family: 'Satoshi', sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.35;
		letter-spacing: 0.01em;
	}

	@media (min-width: 1024px) {
		.about-section {
			padding-top: 74px !important;
			padding-bottom: 51px !important;
		}

		.about-portrait {
			width: min(4.16vw, 48px);
		}

		.about-mobile-name {
			font-size: clamp(28px, 4.4vw, 56px);
		}

		#contact {
			margin-top: 24px !important;
		}
	}

	@media (max-width: 767px) {
		.about-section {
			background-image: none;
		}

		#about :global(img) {
			display: block;
			margin-top: 72px;
			margin-inline: auto;
			width: min(40vw, 200px) !important;
		}

		.about-mobile-name {
			display: block;
			width: 100%;
			margin: 28px 0 0;
			padding: 0;
			text-align: center;
			font-family: 'Panchang', sans-serif;
			font-size: clamp(20px, 7.2vw, 30px);
			font-weight: 500;
			line-height: 0.95;
			letter-spacing: 0;
			white-space: normal;
			color: #0f1115;
			text-transform: none;
		}

		.about-visual-wrap {
			overflow: visible;
		}

		.about-copy {
			margin-top: 30px !important;
		}
	}

	@media (max-width: 639px) {
		#about :global(img) {
			width: min(46vw, 180px) !important;
			max-width: none;
		}

		#contact :global(a) {
			border: 0;
			background: #111111;
			color: #f3f0ee;
		}

		#contact {
			margin-top: 72px !important;
		}

		.about-copy__transition {
			margin-top: 24px !important;
		}

		.about-copy__body {
			margin-top: 24px !important;
		}

	}
</style>
