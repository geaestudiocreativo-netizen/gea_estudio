---
import Layout from '../layouts/Layout.astro';
import PrimaryButton from './PrimaryButton/PrimaryButton.astro';
import type { ServicePageItem } from '../data/services';
import styles from '../pages/services/service-detail.module.css';

type ServicePageContent = {
	systemsTitle: string;
	relatedAria: string;
	viewProjects: string;
	viewProjectsAria: string;
	consultation: string;
	consultationAria: string;
};

interface Props {
	service: ServicePageItem;
	services: ServicePageItem[];
	content: ServicePageContent;
	servicesPath: string;
	projectsPath: string;
	contactPath: string;
}

const { service, services, content, servicesPath, projectsPath, contactPath } = Astro.props;
const relatedServices = services.filter((related) => related.slug !== service.slug);
---

<Layout title={service.seo.title} description={service.seo.description}>
	<main class={styles.page}>
		<section class={styles.hero}>
			<h1 class={styles.title}>{service.title}</h1>
		</section>

		<section class={styles.systems}>
			<p class={styles.systemsEyebrow}>{content.systemsTitle}</p>
			<ul class={styles.systemsList} role="list">
				{
					service.services.map((item) => (
						<li class={styles.systemItem}>{item}</li>
					))
				}
			</ul>
		</section>

		<section class={styles.universe} aria-labelledby="service-universe-title">
			<h2 id="service-universe-title" class={styles.universeTitle}>{service.universeTitle}</h2>
			<p class={styles.universeText}>{service.universeText}</p>

			<nav class={styles.relatedNav} aria-label={content.relatedAria}>
				<ul class={styles.relatedList} role="list">
					{
						relatedServices.map((related) => (
							<li>
								<a href={`${servicesPath}/${related.slug}`}>
									{related.title}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<PrimaryButton
				href={projectsPath}
				label={content.viewProjects}
				ariaLabel={content.viewProjectsAria}
				className={styles.servicesCta}
			/>
		</section>

		<section class={styles.contact} aria-labelledby="service-contact-title">
			<h2 id="service-contact-title" class={styles.contactTitle}>{service.ctaTitle}</h2>
			<p class={styles.contactText}>
				{service.ctaText.split(/(?<=\.)\s+/).map((sentence, index, sentences) => (
					<>
						{index === 0 ? <strong>{sentence}</strong> : sentence}
						{index < sentences.length - 1 && (
							<>
								{' '}<br />
							</>
						)}
					</>
				))}
			</p>
			<PrimaryButton
				href={contactPath}
				label={content.consultation}
				ariaLabel={content.consultationAria}
				className={styles.contactButton}
			/>
		</section>
	</main>
</Layout>