---
import styles from './EditorialGallery.module.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ResponsiveImage from '../ResponsiveImage.astro';
import { projectDetailContent } from '../../i18n/projects-content';
import type { Locale } from '../../i18n/site';
import { getGalleryCaption, getGalleryStatement } from '../../data/gallery-captions';

interface Props {
	images: readonly string[];
	projectTitle: string;
	layout?: 'editorial' | 'vertical';
	frameFirstImages?: boolean;
	naturalTail?: boolean;
	insertBrandStatement?: boolean;
	containLastImage?: boolean;
	singleColumn?: boolean;
	stackMobile?: boolean;
	 paddedImage?: string;
	videos?: readonly string[];
	locale?: Locale;
}

const {
	images,
	projectTitle,
	layout = 'editorial',
	frameFirstImages = false,
	naturalTail = false,
	insertBrandStatement = false,
	containLastImage = false,
	singleColumn = false,
	stackMobile = false,
	paddedImage,
	videos = [],
	locale = 'es'
} = Astro.props as Props;
const content = projectDetailContent[locale];
const IMAGES_PER_BLOCK = 7;

const toOrderedBlocks = (orderedImages: readonly string[]) => {
	const orderedBlocks: string[][] = [];

	for (let index = 0; index < orderedImages.length; index += IMAGES_PER_BLOCK) {
		const blockImages = orderedImages.slice(index, index + IMAGES_PER_BLOCK);
		if (blockImages.length > 0) {
			orderedBlocks.push([...blockImages]);
		}
	}

	return orderedBlocks;
};

const blocks = toOrderedBlocks(images);
// Pie de foto tipo revista: "01 — Logotipo"
// Numeración correlativa solo entre las imágenes que llevan pie
const captionNumbers = new Map<string, number>();
images.filter((image) => getGalleryCaption(image, locale)).forEach((image, index) => captionNumbers.set(image, index + 1));
const caption = (src: string | undefined, _position?: number) => {
	if (!src) return undefined;
	const text = getGalleryCaption(src, locale);
	const number = captionNumbers.get(src);
	return text && number ? `${String(number).padStart(2, '0')} — ${text}` : undefined;
};
const statement = layout === 'editorial' ? getGalleryStatement(images[0], locale) ?? (insertBrandStatement ? content.brandStatement : undefined) : undefined;
// Fotografía tipo Pinterest: cada foto con un formato distinto según un patrón fijo
const PIN_RATIOS = [[2, 3], [4, 5], [3, 4], [1, 1], [3, 5], [4, 5], [2, 3], [5, 6]];
const pin = (index: number) => {
	if (singleColumn || layout !== 'vertical') return {};
	const [w, h] = PIN_RATIOS[index % PIN_RATIOS.length];
	return { style: `--pin: ${w} / ${h}`, 'data-pin-ratio': String(h / w) };
};
const hasCaptions = layout === 'editorial' && images.some((image) => getGalleryCaption(image, locale));

// Si existe un .jpg con el mismo nombre que el vídeo, se usa como portada (se ve aunque el móvil bloquee el autoplay).
const videoPoster = (video: string) => {
	const poster = video.replace(/\.mp4$/, '.jpg');
	return poster !== video && existsSync(join(process.cwd(), 'public', poster)) ? poster : undefined;
};
---

{
	layout === 'vertical' ? (
		<div class={`${styles.verticalStack} ${singleColumn ? styles.singleColumn : ''} ${paddedImage ? styles.paddedSocialGallery : ''}`} data-photography-masonry={!singleColumn ? true : undefined} data-single-column={singleColumn ? 'true' : undefined}>
			{images.slice(0, 2).map((image, index) => (
				<figure class={styles.verticalItem} data-masonry-item {...pin(index)}>
					<ResponsiveImage
						src={image}
						alt={`${projectTitle} editorial ${index + 1}`}
						loading="lazy"
						decoding="async"
						sizes={layout === 'vertical' ? '(max-width: 767px) 100vw, 33vw' : '100vw'}
						widths={[640, 960, 1280, 1600, 1920]}
					/>
				</figure>
			))}
			{videos.length > 0 && (
				<section class={styles.videoRow} aria-label={`${projectTitle} social media videos`}>
					{videos.map((video, index) => (
						<video
							class={styles.socialVideo}
							data-video-src={video}
							poster={videoPoster(video)}
							autoplay
							loop
							muted
							playsinline
							preload="none"
							aria-label={`${projectTitle} social media video ${index + 1}`}
						/>
					))}
				</section>
			)}
			{images.slice(2).map((image, index) => (
				<figure class={`${styles.verticalItem} ${paddedImage === image ? styles.paddedFirstImage : ''}`} data-masonry-item {...pin(index + 2)}>
					<ResponsiveImage
						src={image}
						alt={`${projectTitle} editorial ${index + 3}`}
						loading="lazy"
						decoding="async"
						sizes="100vw"
						widths={[640, 960, 1280, 1600, 1920]}
					/>
				</figure>
			))}
		</div>
	) : (
		blocks.map((blockImages, blockIndex) => (
			<div class={`${styles.layout7} ${hasCaptions ? styles.captioned : ''} ${stackMobile ? styles.stackMobile : ''} ${frameFirstImages && blockIndex === 0 ? styles.frameFirstImages : ''}`}>
				{
					blockImages.length === 1 ? (
						<figure class={`${styles.item} ${styles.itemSingle}`}>
							<ResponsiveImage
								src={blockImages[0]}
								alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 1}`}
								loading="lazy"
								decoding="async"
								sizes="100vw"
								widths={[640, 960, 1280, 1600, 1920]}
							/>
							{caption(blockImages[0], blockIndex * IMAGES_PER_BLOCK + 1) && <figcaption class={styles.caption}>{caption(blockImages[0], blockIndex * IMAGES_PER_BLOCK + 1)}</figcaption>}
						</figure>
					) : blockImages.length === 2 ? (
						<div class={styles.pairBlock}>
							<figure class={`${styles.item} ${styles.itemPair}`}>
								<ResponsiveImage
									src={blockImages[0]}
									alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 1}`}
									loading="lazy"
									decoding="async"
									sizes="(max-width: 767px) 100vw, 50vw"
									widths={[480, 768, 960, 1280]}
								/>
								{caption(blockImages[0], blockIndex * IMAGES_PER_BLOCK + 1) && <figcaption class={styles.caption}>{caption(blockImages[0], blockIndex * IMAGES_PER_BLOCK + 1)}</figcaption>}
							</figure>
							<figure class={`${styles.item} ${styles.itemPair}`}>
								<ResponsiveImage
									src={blockImages[1]}
									alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 2}`}
									loading="lazy"
									decoding="async"
									sizes="(max-width: 767px) 100vw, 50vw"
									widths={[480, 768, 960, 1280]}
								/>
								{caption(blockImages[1], blockIndex * IMAGES_PER_BLOCK + 2) && <figcaption class={styles.caption}>{caption(blockImages[1], blockIndex * IMAGES_PER_BLOCK + 2)}</figcaption>}
							</figure>
						</div>
					) : (
						<>
							<div class={styles.topBlock}>
								<figure class={`${styles.item} ${styles.item1}`}>
									<ResponsiveImage
										src={blockImages[0]}
										alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 1}`}
										loading="lazy"
										decoding="async"
										sizes="(max-width: 767px) 100vw, 38vw"
										widths={[360, 520, 768, 960]}
									/>
									{caption(blockImages[0], blockIndex * IMAGES_PER_BLOCK + 1) && <figcaption class={styles.caption}>{caption(blockImages[0], blockIndex * IMAGES_PER_BLOCK + 1)}</figcaption>}
								</figure>
								<figure class={`${styles.item} ${styles.item2}`}>
									<ResponsiveImage
										src={blockImages[1]}
										alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 2}`}
										loading="lazy"
										decoding="async"
										sizes="(max-width: 767px) 100vw, 38vw"
										widths={[360, 520, 768, 960]}
									/>
									{caption(blockImages[1], blockIndex * IMAGES_PER_BLOCK + 2) && <figcaption class={styles.caption}>{caption(blockImages[1], blockIndex * IMAGES_PER_BLOCK + 2)}</figcaption>}
								</figure>
								<figure class={`${styles.item} ${styles.item3}`}>
									<ResponsiveImage
										src={blockImages[2]}
										alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 3}`}
										loading="lazy"
										decoding="async"
										sizes="(max-width: 767px) 100vw, 62vw"
										widths={[520, 768, 960, 1280, 1600]}
									/>
									{caption(blockImages[2], blockIndex * IMAGES_PER_BLOCK + 3) && <figcaption class={styles.caption}>{caption(blockImages[2], blockIndex * IMAGES_PER_BLOCK + 3)}</figcaption>}
								</figure>
							</div>

							{
								statement && blockIndex === 0 && blockImages[4] && (
									<div class={styles.brandStatement}>
														<p>{statement}</p>
									</div>

									<script>
										const galleryVideos = document.querySelectorAll<HTMLVideoElement>('[data-video-src]');
										const galleryObserver = new IntersectionObserver((entries) => {
											entries.forEach((entry) => {
												if (!entry.isIntersecting) return;
												const video = entry.target as HTMLVideoElement;
												const source = video.dataset.videoSrc;
												if (source && !video.src) {
													video.src = source;
													video.load();
													void video.play().catch(() => { video.controls = true; });
												}
												galleryObserver.unobserve(video);
											});
										}, { rootMargin: '300px 0px' });

										galleryVideos.forEach((video) => galleryObserver.observe(video));
									</script>
								)
							}

							{
								blockImages[3] && (
									<figure class={`${styles.item} ${styles.item4}`}>
										<ResponsiveImage
											src={blockImages[3]}
											alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 4}`}
											loading="lazy"
											decoding="async"
											sizes="100vw"
											widths={[640, 960, 1280, 1600, 1920]}
										/>
										{caption(blockImages[3], blockIndex * IMAGES_PER_BLOCK + 4) && <figcaption class={styles.caption}>{caption(blockImages[3], blockIndex * IMAGES_PER_BLOCK + 4)}</figcaption>}
									</figure>
								)
							}

							{
								naturalTail && blockImages.length > 4 && (
									<div class={styles.tailRow} style={`--tail-cols: ${Math.min(blockImages.length - 4, 3)}`}>
										{blockImages.slice(4).map((image, i) => (
											<figure class={`${styles.item} ${styles.tailItem}`}>
												<ResponsiveImage
													src={image}
													alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 5 + i}`}
													loading="lazy"
													decoding="async"
													sizes="(max-width: 767px) 100vw, 33vw"
													widths={[480, 768, 960, 1280]}
												/>
												{caption(image, blockIndex * IMAGES_PER_BLOCK + 5 + i) && <figcaption class={styles.caption}>{caption(image, blockIndex * IMAGES_PER_BLOCK + 5 + i)}</figcaption>}
											</figure>
										))}
									</div>
								)
							}

							{
								!naturalTail && (blockImages[4] || blockImages[5]) && (
									<div class={`${styles.middleBlock} ${!blockImages[5] ? styles.middleBlockSingle : ''}`}>
										{
											blockImages[4] && (
														<figure class={`${styles.item} ${styles.item5} ${containLastImage && blockIndex === blocks.length - 1 ? styles.containLastImage : ''}`}>
													<ResponsiveImage
														src={blockImages[4]}
														alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 5}`}
														loading="lazy"
														decoding="async"
														sizes="(max-width: 767px) 100vw, 50vw"
														widths={[480, 768, 960, 1280]}
													/>
													{caption(blockImages[4], blockIndex * IMAGES_PER_BLOCK + 5) && <figcaption class={styles.caption}>{caption(blockImages[4], blockIndex * IMAGES_PER_BLOCK + 5)}</figcaption>}
												</figure>
											)
										}
										{
											blockImages[5] && (
												<figure class={`${styles.item} ${styles.item6}`}>
													<ResponsiveImage
														src={blockImages[5]}
														alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 6}`}
														loading="lazy"
														decoding="async"
														sizes="(max-width: 767px) 100vw, 50vw"
														widths={[480, 768, 960, 1280]}
													/>
													{caption(blockImages[5], blockIndex * IMAGES_PER_BLOCK + 6) && <figcaption class={styles.caption}>{caption(blockImages[5], blockIndex * IMAGES_PER_BLOCK + 6)}</figcaption>}
												</figure>
											)
										}
									</div>
								)
							}

							{
								!naturalTail && blockImages[6] && (
									<figure class={`${styles.item} ${styles.item7}`}>
										<ResponsiveImage
											src={blockImages[6]}
											alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 7}`}
											loading="lazy"
											decoding="async"
											sizes="100vw"
											widths={[640, 960, 1280, 1600, 1920]}
										/>
										{caption(blockImages[6], blockIndex * IMAGES_PER_BLOCK + 7) && <figcaption class={styles.caption}>{caption(blockImages[6], blockIndex * IMAGES_PER_BLOCK + 7)}</figcaption>}
									</figure>
								)
							}
						</>
					)
				}
			</div>
		))
	)
}

{layout === 'editorial' && videos.length > 0 && (
	<section class={styles.editorialVideoBand} aria-label={`${projectTitle} vídeo`}>
		{videos.map((video, index) => (
			<video
				class={styles.editorialVideo}
				data-video-src={video}
							poster={videoPoster(video)}
				autoplay
				loop
				muted
				playsinline
				preload="none"
				aria-label={`${projectTitle} vídeo ${index + 1}`}
			/>
		))}
	</section>
)}

{layout === 'vertical' && (
	<script>
		const masonryStacks = Array.from(document.querySelectorAll('[data-photography-masonry]'));

		const arrangeMasonry = (stack: HTMLElement) => {
			const items = Array.from(stack.querySelectorAll('[data-masonry-item]'));
			const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
			const columnCount = stack.dataset.singleColumn === 'true' ? 1 : (isDesktop ? 4 : 2);
			const columns = Array.from({ length: columnCount }, () => document.createElement('div'));
			const gap = isDesktop ? 12 : 8;
			const heights = columns.map(() => 0);

			for (const column of Array.from(stack.querySelectorAll('[data-masonry-column]'))) {
				column.remove();
			}

			for (const column of columns) {
				column.dataset.masonryColumn = '';
				stack.append(column);
			}

			if (isDesktop || stack.dataset.singleColumn !== 'true') {
				const columnWidth = (stack.clientWidth - gap * (columnCount - 1)) / columnCount;
				for (const item of items) {
					const image = item.querySelector('img');
					const pinRatio = Number((item as HTMLElement).dataset.pinRatio);
					const aspectRatio = pinRatio > 0
						? pinRatio
						: image?.naturalWidth && image.naturalHeight
							? image.naturalHeight / image.naturalWidth
							: 1;
					const shortestColumn = heights.indexOf(Math.min(...heights));
					columns[shortestColumn].append(item);
					heights[shortestColumn] += columnWidth * aspectRatio + gap;
				}
			} else {
				const itemsPerColumn = Math.ceil(items.length / columnCount);
				for (let columnIndex = 0; columnIndex < columns.length; columnIndex += 1) {
					const start = columnIndex * itemsPerColumn;
					columns[columnIndex].append(...items.slice(start, start + itemsPerColumn));
				}
			}

			stack.dataset.masonryReady = '';
		};

		for (const stack of masonryStacks) {
			const images = Array.from(stack.querySelectorAll('img'));
			Promise.all(images.map((image) => image.complete
				? Promise.resolve()
				: new Promise<void>((resolve) => image.addEventListener('load', () => resolve(), { once: true }))))
				.then(() => arrangeMasonry(stack as HTMLElement));

			let resizeFrame = 0;
			let lastWidth = stack.getBoundingClientRect().width;
			const resizeObserver = new ResizeObserver(() => {
				const width = stack.getBoundingClientRect().width;
				if (width === lastWidth) {
					return;
				}
				lastWidth = width;
				cancelAnimationFrame(resizeFrame);
				resizeFrame = requestAnimationFrame(() => arrangeMasonry(stack as HTMLElement));
			});
			resizeObserver.observe(stack);
		}
	</script>
)}
