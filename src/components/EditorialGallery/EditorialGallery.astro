---
import styles from './EditorialGallery.module.css';
import ResponsiveImage from '../ResponsiveImage.astro';
import { projectDetailContent } from '../../i18n/projects-content';
import type { Locale } from '../../i18n/site';

interface Props {
	images: readonly string[];
	projectTitle: string;
	layout?: 'editorial' | 'vertical';
	frameFirstImages?: boolean;
	insertBrandStatement?: boolean;
	containLastImage?: boolean;
	singleColumn?: boolean;
	stackMobile?: boolean;
	 paddedImage?: string;
	videos?: readonly string[];
	locale?: Locale;
}

const {
	images,
	projectTitle,
	layout = 'editorial',
	frameFirstImages = false,
	insertBrandStatement = false,
	containLastImage = false,
	singleColumn = false,
	stackMobile = false,
	paddedImage,
	videos = [],
	locale = 'es'
} = Astro.props as Props;
const content = projectDetailContent[locale];
const IMAGES_PER_BLOCK = 7;

const toOrderedBlocks = (orderedImages: readonly string[]) => {
	const orderedBlocks: string[][] = [];

	for (let index = 0; index < orderedImages.length; index += IMAGES_PER_BLOCK) {
		const blockImages = orderedImages.slice(index, index + IMAGES_PER_BLOCK);
		if (blockImages.length > 0) {
			orderedBlocks.push([...blockImages]);
		}
	}

	return orderedBlocks;
};

const blocks = toOrderedBlocks(images);
---

{
	layout === 'vertical' ? (
		<div class={`${styles.verticalStack} ${singleColumn ? styles.singleColumn : ''} ${paddedImage ? styles.paddedSocialGallery : ''}`} data-photography-masonry={!singleColumn ? true : undefined} data-single-column={singleColumn ? 'true' : undefined}>
			{images.slice(0, 2).map((image, index) => (
				<figure class={styles.verticalItem} data-masonry-item>
					<ResponsiveImage
						src={image}
						alt={`${projectTitle} editorial ${index + 1}`}
						loading="lazy"
						decoding="async"
						sizes={layout === 'vertical' ? '(max-width: 767px) 100vw, 33vw' : '100vw'}
						widths={[640, 960, 1280, 1600, 1920]}
					/>
				</figure>
			))}
			{videos.length > 0 && (
				<section class={styles.videoRow} aria-label={`${projectTitle} social media videos`}>
					{videos.map((video, index) => (
						<video
							class={styles.socialVideo}
							data-video-src={video}
							autoplay
							loop
							muted
							playsinline
							preload="none"
							aria-label={`${projectTitle} social media video ${index + 1}`}
						/>
					))}
				</section>
			)}
			{images.slice(2).map((image, index) => (
				<figure class={`${styles.verticalItem} ${paddedImage === image ? styles.paddedFirstImage : ''}`} data-masonry-item>
					<ResponsiveImage
						src={image}
						alt={`${projectTitle} editorial ${index + 3}`}
						loading="lazy"
						decoding="async"
						sizes="100vw"
						widths={[640, 960, 1280, 1600, 1920]}
					/>
				</figure>
			))}
		</div>
	) : (
		blocks.map((blockImages, blockIndex) => (
			<div class={`${styles.layout7} ${stackMobile ? styles.stackMobile : ''} ${frameFirstImages && blockIndex === 0 ? styles.frameFirstImages : ''}`}>
				{
					blockImages.length === 1 ? (
						<figure class={`${styles.item} ${styles.itemSingle}`}>
							<ResponsiveImage
								src={blockImages[0]}
								alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 1}`}
								loading="lazy"
								decoding="async"
								sizes="100vw"
								widths={[640, 960, 1280, 1600, 1920]}
							/>
						</figure>
					) : blockImages.length === 2 ? (
						<div class={styles.pairBlock}>
							<figure class={`${styles.item} ${styles.itemPair}`}>
								<ResponsiveImage
									src={blockImages[0]}
									alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 1}`}
									loading="lazy"
									decoding="async"
									sizes="(max-width: 767px) 100vw, 50vw"
									widths={[480, 768, 960, 1280]}
								/>
							</figure>
							<figure class={`${styles.item} ${styles.itemPair}`}>
								<ResponsiveImage
									src={blockImages[1]}
									alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 2}`}
									loading="lazy"
									decoding="async"
									sizes="(max-width: 767px) 100vw, 50vw"
									widths={[480, 768, 960, 1280]}
								/>
							</figure>
						</div>
					) : (
						<>
							<div class={styles.topBlock}>
								<figure class={`${styles.item} ${styles.item1}`}>
									<ResponsiveImage
										src={blockImages[0]}
										alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 1}`}
										loading="lazy"
										decoding="async"
										sizes="(max-width: 767px) 100vw, 38vw"
										widths={[360, 520, 768, 960]}
									/>
								</figure>
								<figure class={`${styles.item} ${styles.item2}`}>
									<ResponsiveImage
										src={blockImages[1]}
										alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 2}`}
										loading="lazy"
										decoding="async"
										sizes="(max-width: 767px) 100vw, 38vw"
										widths={[360, 520, 768, 960]}
									/>
								</figure>
								<figure class={`${styles.item} ${styles.item3}`}>
									<ResponsiveImage
										src={blockImages[2]}
										alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 3}`}
										loading="lazy"
										decoding="async"
										sizes="(max-width: 767px) 100vw, 62vw"
										widths={[520, 768, 960, 1280, 1600]}
									/>
								</figure>
							</div>

							{
								blockImages[3] && (
									<figure class={`${styles.item} ${styles.item4}`}>
										<ResponsiveImage
											src={blockImages[3]}
											alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 4}`}
											loading="lazy"
											decoding="async"
											sizes="100vw"
											widths={[640, 960, 1280, 1600, 1920]}
										/>
									</figure>
								)
							}

							{
								insertBrandStatement && blockIndex === 0 && blockImages[4] && (
									<div class={styles.brandStatement}>
														<p>{content.brandStatement}</p>
									</div>

									<script>
										const galleryVideos = document.querySelectorAll<HTMLVideoElement>('[data-video-src]');
										const galleryObserver = new IntersectionObserver((entries) => {
											entries.forEach((entry) => {
												if (!entry.isIntersecting) return;
												const video = entry.target as HTMLVideoElement;
												const source = video.dataset.videoSrc;
												if (source && !video.src) {
													video.src = source;
													video.load();
													void video.play().catch(() => undefined);
												}
												galleryObserver.unobserve(video);
											});
										}, { rootMargin: '300px 0px' });

										galleryVideos.forEach((video) => galleryObserver.observe(video));
									</script>
								)
							}

							{
								(blockImages[4] || blockImages[5]) && (
									<div class={`${styles.middleBlock} ${!blockImages[5] ? styles.middleBlockSingle : ''}`}>
										{
											blockImages[4] && (
														<figure class={`${styles.item} ${styles.item5} ${containLastImage && blockIndex === blocks.length - 1 ? styles.containLastImage : ''}`}>
													<ResponsiveImage
														src={blockImages[4]}
														alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 5}`}
														loading="lazy"
														decoding="async"
														sizes="(max-width: 767px) 100vw, 50vw"
														widths={[480, 768, 960, 1280]}
													/>
												</figure>
											)
										}
										{
											blockImages[5] && (
												<figure class={`${styles.item} ${styles.item6}`}>
													<ResponsiveImage
														src={blockImages[5]}
														alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 6}`}
														loading="lazy"
														decoding="async"
														sizes="(max-width: 767px) 100vw, 50vw"
														widths={[480, 768, 960, 1280]}
													/>
												</figure>
											)
										}
									</div>
								)
							}

							{
								blockImages[6] && (
									<figure class={`${styles.item} ${styles.item7}`}>
										<ResponsiveImage
											src={blockImages[6]}
											alt={`${projectTitle} editorial ${blockIndex * IMAGES_PER_BLOCK + 7}`}
											loading="lazy"
											decoding="async"
											sizes="100vw"
											widths={[640, 960, 1280, 1600, 1920]}
										/>
									</figure>
								)
							}
						</>
					)
				}
			</div>
		))
	)
}

{layout === 'vertical' && (
	<script>
		const masonryStacks = Array.from(document.querySelectorAll('[data-photography-masonry]'));

		const arrangeMasonry = (stack: HTMLElement) => {
			const items = Array.from(stack.querySelectorAll('[data-masonry-item]'));
			const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
			const columnCount = stack.dataset.singleColumn === 'true' ? 1 : (isDesktop ? 3 : 2);
			const columns = Array.from({ length: columnCount }, () => document.createElement('div'));
			const gap = isDesktop ? Math.min(Math.max(window.innerWidth * 0.02, 16), 32) : 10;
			const heights = columns.map(() => 0);

			for (const column of Array.from(stack.querySelectorAll('[data-masonry-column]'))) {
				column.remove();
			}

			for (const column of columns) {
				column.dataset.masonryColumn = '';
				stack.append(column);
			}

			if (isDesktop) {
				const columnWidth = (stack.clientWidth - gap * (columnCount - 1)) / columnCount;
				for (const item of items) {
					const image = item.querySelector('img');
					const aspectRatio = image?.naturalWidth && image.naturalHeight
						? image.naturalHeight / image.naturalWidth
						: 1;
					const shortestColumn = heights.indexOf(Math.min(...heights));
					columns[shortestColumn].append(item);
					heights[shortestColumn] += columnWidth * aspectRatio + gap;
				}
			} else {
				const itemsPerColumn = Math.ceil(items.length / columnCount);
				for (let columnIndex = 0; columnIndex < columns.length; columnIndex += 1) {
					const start = columnIndex * itemsPerColumn;
					columns[columnIndex].append(...items.slice(start, start + itemsPerColumn));
				}
			}

			stack.dataset.masonryReady = '';
		};

		for (const stack of masonryStacks) {
			const images = Array.from(stack.querySelectorAll('img'));
			Promise.all(images.map((image) => image.complete
				? Promise.resolve()
				: new Promise<void>((resolve) => image.addEventListener('load', () => resolve(), { once: true }))))
				.then(() => arrangeMasonry(stack as HTMLElement));

			let resizeFrame = 0;
			let lastWidth = stack.getBoundingClientRect().width;
			const resizeObserver = new ResizeObserver(() => {
				const width = stack.getBoundingClientRect().width;
				if (width === lastWidth) {
					return;
				}
				lastWidth = width;
				cancelAnimationFrame(resizeFrame);
				resizeFrame = requestAnimationFrame(() => arrangeMasonry(stack as HTMLElement));
			});
			resizeObserver.observe(stack);
		}
	</script>
)}
