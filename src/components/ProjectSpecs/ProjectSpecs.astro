---
import styles from './ProjectSpecs.module.css';
import type { Project } from '../../data/projects';
import type { Locale } from '../../i18n/site';
import { getLocalizedProjectDescription, localizeServiceType } from '../../data/projects-i18n';

interface Props {
	project: Project;
	locale?: Locale;
}

const { project, locale = 'es' } = Astro.props as Props;
const en = locale === 'en';

const sector = en ? project.sectorEn ?? project.sector : project.sector;

const first = sector;
// Texto breve del caso: el reto, qué hicimos y el resultado
const caseText = getLocalizedProjectDescription(project, locale);
// Folio de revista: número del proyecto y servicios
const folioServices = [...new Set(project.services.map((service) => localizeServiceType(service.type, locale)))].join(' · ');
---

<div class={styles.specs}>
	{first && <p class={styles.line}>{first}</p>}
	<p class={styles.sub}>{project.location ? `${project.location} — ${project.year}` : project.year}</p>
	{project.concept && <span class="concept-tag">{en ? 'Concept project - AI' : 'Proyecto conceptual - IA'}</span>}
	{caseText && (
		<div class={styles.article}>
			<p class={styles.folio}>
				<span>N.º {project.id}</span>
				<span>{folioServices}</span>
			</p>
			<p class={styles.case}>{caseText}</p>
		</div>
	)}
</div>
