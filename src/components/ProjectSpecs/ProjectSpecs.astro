---
import styles from './ProjectSpecs.module.css';
import type { Project } from '../../data/projects';
import type { Locale } from '../../i18n/site';

interface Props {
	project: Project;
	locale?: Locale;
}

const { project, locale = 'es' } = Astro.props as Props;
const en = locale === 'en';

const sector = en ? project.sectorEn ?? project.sector : project.sector;

const rows = [
	sector && { label: en ? 'Sector' : 'Sector', value: sector },
	{ label: en ? 'Location' : 'Lugar', value: project.location },
	project.concept && { label: en ? 'Type' : 'Tipo', value: en ? 'Concept · AI' : 'Concepto · IA' }
].filter(Boolean) as { label: string; value: string }[];
---

<dl class={styles.specs}>
	{rows.map((row) => (
		<div class={styles.spec}>
			<dt class={styles.label}>{row.label}</dt>
			<dd class={styles.value}>{row.value}</dd>
		</div>
	))}
</dl>
